// Selected symbol: circuit(params)
use std::quantum::h;
use std::quantum::x;
use std::quantum::z;
use std::quantum::s;
use std::quantum::t;
use std::quantum::tdg;
use std::quantum::id;
use std::quantum::phase_eighth;
use std::quantum::toffoli;
use std::quantum::cnot;
use std::quantum::join;
use std::quantum::split;

unitary fn rz(q: Q<Bit>) -> Q<Bit> { inverse(phase_eighth)(s(q)) }
unitary fn rx(q: Q<Bit>) -> Q<Bit> { h(rz(h(q))) }
pub unitary fn kernel(q: Q<Bit>) -> Q<Bit> { z(h(inverse(rx)(q))) }
