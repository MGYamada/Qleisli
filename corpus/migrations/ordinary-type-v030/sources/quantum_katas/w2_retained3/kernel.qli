// Modified from https://github.com/microsoft/QuantumKatas/blob/1a4740ff70ceffebde73d1434b2dedbe27643300/Superposition/ReferenceImplementation.qs
// Selected symbol: WState_PowerOfTwo_Reference
use std::quantum::split;
use std::quantum::join;
use std::quantum::x;
use std::quantum::h;
use std::quantum::cnot;

unitary fn identity(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> { q }
unitary fn swap_pair(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    join(b, a)
}
pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, d) = split(q);
    let (a, b) = split(ab);
    let (d, ab) = qif(h(d), join(x(a), b)) { 0 => identity, 1 => swap_pair };
    let (a, b) = split(ab);
    let (b, d) = cnot(b, d);
    join(join(a, b), d)
}
