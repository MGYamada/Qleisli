use std::quantum::init0;
use std::quantum::h;
use std::quantum::cnot;
use std::quantum::split;
use std::observe::measure_z;
pub iso fn entangle(q: Q<Bit>) -> Q<(Bit,Bit)> { basis q as x { (x,x) } }
observe fn main() -> (Bit,Bit) { let (a,b)=split(entangle(h(init0()))); (measure_z(a),measure_z(b)) }
