use std::quantum::{init0,h,cnot}; use std::observe::measure_z;
pub observe fn f() -> (Bit,Bit) {
    let (q,r) = cnot(h(init0()),init0());
    let a = measure_z(q); let b = measure_z(r); (a,a xor b)
}
pub observe fn main() -> (Bit,Bit) { f() }
