//! Estimate phase 3/8; print the weight-one bit first and retain the target.
use estimation::phase3;
use gates::eighth_phase;
use std::state::init0;
use std::gate::x;

observe fn main() -> ((Bit,Bit,Bit),Bit) {
    let (phase_word,target) = phase3[power(eighth_phase,3)](x(init0()));
    (phase_word,measure_z(target))
}
