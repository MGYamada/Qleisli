use std::quantum::{unit,finish,split,join,phase_eighth};
pub unitary fn remove(q:Q<(Unit,(Unit,(Bit,Unit)))>)->Q<(Unit,(Bit,Unit))>{let(u,a)=split(q);let()=finish(u);a}
pub unitary fn insert(a:Q<(Unit,(Bit,Unit))>)->Q<(Unit,(Unit,(Bit,Unit)))>{join(unit(()),a)}
pub unitary fn round(q:Q<(Unit,(Unit,(Bit,Unit)))>)->Q<(Unit,(Unit,(Bit,Unit)))>{let(u,a)=split(q);let()=finish(u);join(unit(()),a)}
pub unitary fn phase_remove(q:Q<(Unit,(Unit,(Bit,Unit)))>)->Q<(Unit,(Bit,Unit))>{let(u,a)=split(q);let()=finish(phase_eighth(u));a}
