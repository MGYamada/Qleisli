fn strip(q:Q<(Unit,Bit)>)->Q<Bit>{let(u,b)=split(q);finish(u);b}
fn reverse[const U:Op<(Unit,Bit) -> Bit>](q:Q<Bit>)->Q<(Unit,Bit)>
requires Adjointable(U){adjoint(U)(q)}
pub unitary fn main(q:Q<Bit>)->Q<(Unit,Bit)>{reverse[strip](q)}
