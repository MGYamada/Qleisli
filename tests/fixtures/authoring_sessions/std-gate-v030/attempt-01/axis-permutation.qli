use std::quantum::{init0,x,split,join}; use std::observe::measure_z; use std::gate::{swap,permute_axes};
pub observe fn main()->(Bit,Bit){let q=join(init0(),x(init0()));let q=permute_axes(q);let(a,b)=split(q);(measure_z(a),measure_z(b))}
