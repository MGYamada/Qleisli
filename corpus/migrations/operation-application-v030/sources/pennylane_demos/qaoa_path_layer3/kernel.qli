// Selected symbol: U_C; U_B
use std::quantum::split;
use std::quantum::join;
use std::quantum::h;
use std::quantum::s;
use std::quantum::phase_eighth;
use std::quantum::cnot;

unitary fn rz(q: Q<Bit>) -> Q<Bit> { inverse(phase_eighth)(s(q)) }
unitary fn rx(q: Q<Bit>) -> Q<Bit> { h(rz(h(q))) }
pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, d) = split(q);
    let (a, b) = split(ab);
    let (a, b) = cnot(a, b);
    let (a, b) = cnot(a, rz(b));
    let (b, d) = cnot(b, d);
    let (b, d) = cnot(b, rz(d));
    join(join(rx(a), rx(b)), rx(d))
}
