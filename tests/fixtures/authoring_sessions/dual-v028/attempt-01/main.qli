use std::quantum::init0;
use std::quantum::h;
use std::quantum::x;
use std::observe::measure_z;

observe fn main() -> (CBit, CBit) {
    let coin = measure_z(h(init0()));
    let target = init0();
    let target = if coin { x(target) } else { target };
    (coin, measure_z(target))
}
