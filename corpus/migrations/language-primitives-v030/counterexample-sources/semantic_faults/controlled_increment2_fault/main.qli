// Selected symbol: AddK; controlled specialization
use std::state::init0;

use std::gate::x;
use std::gate::t;
use std::gate::cnot;



use kernel::kernel;
observe fn main() -> ((Bit, Bit), Bit) {
let q = join(join(x(init0()), x(init0())), x(init0()));
let q = kernel(q);
let (part2, w2) = split(q);
let (w0, w1) = split(part2);
((measure_z(w0), measure_z(w1)), measure_z(w2))
}
