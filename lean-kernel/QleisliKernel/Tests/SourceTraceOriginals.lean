  ("std::basis","//! Total finite classical functions, implemented as ordinary checked source.\n//!\n//! These functions take ordinary labels, including already measured Bit results.\n//! They cannot inspect live quantum owners or perform observation.\n//! Runtime argument effects remain in the caller. Importing or calling these\n//! helpers grants no quantum primitive, access or verification privilege.\n//! Contracts and finite regression status: Contract identifiers: B001-B002.\n\n/// Return x xor y for all four pairs of Bit inputs.\n/// This two-argument map is total but not injective on the product domain.\n/// A coherent lift must check injectivity of its complete enclosing map.\npub classical fn xor2(x: Bit, y: Bit) -> Bit { x xor y }\n\n/// Return x and y for all four pairs of Bit inputs.\n/// This total, noninjective predicate can describe reversible XOR computation\n/// into an auxiliary; calling it does not measure a quantum register.\npub classical fn and2(x: Bit, y: Bit) -> Bit { x and y }\n"),
  ("std::gate","//! Ordinary phase-fixed gate definitions for edition 2026.\n//!\n//! Every body uses the same source and native checks as user code. No function\n//! here is a sealed gate intrinsic or a structural axis-routing helper.\n//! Copyright 2026 Qleisli Project Contributors. SPDX-License-Identifier: Apache-2.0.\n\n/// Identity preserves the exact Basis tree, including zero-width owners.\npub unitary fn id[const A: Basis](q: Q<A>) -> Q<A> { q }\n\n/// Exact scalar zeta_8 I on one logical Unit owner, including its phase.\nunitary fn scalar_eighth(u: Q<Unit>) -> Q<Unit> {\n    global_phase_eighth(u)\n}\n\n/// T = diag(1,zeta_8), with exact phase for every input and external reference.\n/// Coherent control exposes the scalar as relative phase. The Unit target has\n/// no physical wire, but remains owned until finish; realized T cost is separate.\npub unitary fn t(q: Q<Bit>) -> Q<Bit> {\n    let (q,u) = controlled(scalar_eighth)(q,unit(()));\n    finish(u);\n    q\n}\n\n/// Quarter-turn phase: diag(1,i).\npub unitary fn s(q: Q<Bit>) -> Q<Bit> { phase[1,2](q) }\n\n/// Inverse S: diag(1,-i).\npub unitary fn sdg(q: Q<Bit>) -> Q<Bit> { adjoint(s)(q) }\n\n/// Inverse T: diag(1,zeta_8^-1).\npub unitary fn tdg(q: Q<Bit>) -> Q<Bit> { adjoint(t)(q) }\n\n/// Half-turn phase: diag(1,-1).\npub unitary fn z(q: Q<Bit>) -> Q<Bit> { phase[1,1](q) }\n\n/// Bit flip: H Z H = |1><0| + |0><1|.\npub unitary fn x(q: Q<Bit>) -> Q<Bit> { h(z(h(q))) }\n\n/// Dyadic phase provider for coherent control: diag(1,exp(2*pi*i*j/2^k)).\nunitary fn phase_leaf[const j: Nat, const k: Nat](q: Q<Bit>) -> Q<Bit> {\n    phase[j,k](q)\n}\n\n/// Exact diag(1,1,1,exp(2*pi*i*j/2^k)) in control/target axis order.\n/// The phase provider retains its own concrete coefficient/profile conditions.\n/// Both owners return; no measurement, workspace or implicit phase quotient.\npub unitary fn controlled_phase[const j: Nat, const k: Nat](a: Q<Bit>, b: Q<Bit>) -> (Q<Bit>, Q<Bit>) {\n    controlled(phase_leaf[j,k]