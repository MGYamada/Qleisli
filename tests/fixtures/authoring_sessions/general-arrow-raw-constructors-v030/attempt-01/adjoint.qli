use std::quantum::{x,phase};
fn flip(q:Q<Bit>)->Q<Bit>{x(q)}
fn id(q:Q<Bit>)->Q<Bit>{q}
fn twist(q:Q<Bit>)->Q<Bit>{phase[1,3](q)}
classical fn negative(b:Bit)->(Bit,(Bit,Bit)){(b,(b,b))}
meaning M:Bit=phase_by(negative);
fn invoke[const U:Op<Bit,M>](q:Q<Bit>)->Q<Bit> requires Applicable(U){U(q)}
pub fn main(q:Q<Bit>)->Q<Bit>{invoke[adjoint(twist)](q)}
