// Local integration client of the retained Qualtran-derived QPE source.
use rotation::prepare;
use amplification::grover;
use estimation::estimate;

/// Prepare the low-bit success amplitude, then reuse the same QPE definition.
/// Measurement/CBits and certified classical sin-squared evaluation are separate.
pub unitary fn amplitude_phase[static n: Nat, static m: Nat, static j: Nat, static d: Nat](
    phase: Q<Bits<m>>, target: Q<Bits<n>>
) -> (Q<Bits<m>>, Q<Bits<n>>)
requires n >= 1, m >= 1 {
    let target = prepare[n,j,d](target);
    estimate[n,m,grover[n,j,d]](phase,target)
}
