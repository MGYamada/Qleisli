use std::quantum::{unit,finish,split,join,phase_eighth};
use std::observe::measure_z;
use std::classical::{empty_bits,prepend_bit};
pub observe fn f(q:Q<Bit>,r:Q<(Unit,Bit)>)->(Bits<1>,Q<(Unit,Bit)>){let b=measure_z(q);let(u,a)=split(r);let r=join(u,a);(prepend_bit[0](b,empty_bits()),r)}
