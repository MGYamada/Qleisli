use std::quantum::{init0,h}; use std::observe::measure_z;
observe fn forget(q: Q<Bit>) -> Unit { let _ = measure_z(q); () }
pub observe fn f() -> Bit { let () = forget(h(init0())); not 0 }
pub observe fn main() -> Bit { f() }
