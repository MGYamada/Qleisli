fn strip(q:Q<(Unit,Bit)>)->Q<Bit>{let(u,b)=split(q);finish(u);b}
fn invoke[const U:Op<(Unit,Bit) -> Bit>](q:Q<(Unit,Bit)>)->Q<Bit> requires Applicable(U){U(q)}
pub isometry fn main(q:Q<(Unit,Bit)>)->Q<Bit>{invoke[strip](q)}
