import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots
import Mathlib.Data.Matrix.Mul

/-! Necessary exact coefficient conditions for target circuit products. -/
namespace QPTL.FiniteMatrix

open Polynomial IntermediateField

/-- The rational field generated by an eighth root cannot contain a primitive
sixteenth root. The relative phase of a controlled sixteenth turn therefore
fails a necessary coefficient condition for an eighth-root target. -/
theorem primitiveSixteenth_not_in_eighth_field {K : Type*} [Field K] [Algebra ℚ K]
    {eighth sixteenth : K} (eight : IsPrimitiveRoot eighth 8)
    (sixteen : IsPrimitiveRoot sixteenth 16) : sixteenth ∉ ℚ⟮eighth⟯ := by
  intro member
  haveI : NeZero (8 : Nat) := ⟨by decide⟩
  haveI : NeZero (16 : Nat) := ⟨by decide⟩
  have eighthIntegral : IsIntegral ℚ eighth :=
    IsIntegral.of_pow (n := 8) (by decide) (eight.pow_eq_one.symm ▸ isIntegral_one)
  have sixteenthIntegral : IsIntegral ℚ sixteenth :=
    IsIntegral.of_pow (n := 16) (by decide) (sixteen.pow_eq_one.symm ▸ isIntegral_one)
  have included : ℚ⟮sixteenth⟯ ≤ ℚ⟮eighth⟯ := adjoin_simple_le_iff.mpr member
  letI : FiniteDimensional ℚ ℚ⟮eighth⟯ := IntermediateField.adjoin.finiteDimensional eighthIntegral
  have eighthSize : Module.finrank ℚ ℚ⟮eighth⟯ = 4 := by
    have polynomial : minpoly ℚ eighth = cyclotomic 8 ℚ :=
      (eight.minpoly_eq_cyclotomic_of_irreducible (cyclotomic.irreducible_rat (by decide))).symm
    rw [IntermediateField.adjoin.finrank eighthIntegral, polynomial, natDegree_cyclotomic]
    decide
  have sixteenthSize : Module.finrank ℚ ℚ⟮sixteenth⟯ = 8 := by
    have polynomial : minpoly ℚ sixteenth = cyclotomic 16 ℚ :=
      (sixteen.minpoly_eq_cyclotomic_of_irreducible (cyclotomic.irreducible_rat (by decide))).symm
    rw [IntermediateField.adjoin.finrank sixteenthIntegral, polynomial, natDegree_cyclotomic]
    decide
  have subspaces : (ℚ⟮sixteenth⟯ : IntermediateField ℚ K).toSubmodule ≤
      (ℚ⟮eighth⟯ : IntermediateField ℚ K).toSubmodule := included
  have lower : Module.finrank ℚ ℚ⟮sixteenth⟯ ≤ Module.finrank ℚ ℚ⟮eighth⟯ :=
    Submodule.finrank_mono subspaces
  rw [eighthSize,sixteenthSize] at lower
  omega

/-- Every literal product over the declared coefficient field remains in
the field. Its finite index type can include any number of work axes. -/
theorem product_entries_mem {K P : Type*} [Field K] [Algebra ℚ K]
    [Fintype P] [DecidableEq P] (field : IntermediateField ℚ K)
    (steps : List (Matrix P P K))
    (entries : ∀ gate ∈ steps, ∀ row col, gate row col ∈ field) :
    ∀ row col, steps.prod row col ∈ field := by
  induction steps with
  | nil =>
    intro row col
    by_cases same : row = col
    · simp [same]
    · simp [same]
  | cons gate rest ih =>
    intro row col
    rw [List.prod_cons, Matrix.mul_apply]
    apply sum_mem
    intro i _
    exact mul_mem (entries gate (List.mem_cons_self ..) row i)
      (ih (fun other member => entries other (List.mem_cons_of_mem _ member)) i col)

/-- A clean-workspace extraction selects actual coefficients. A phase
outside the target field cannot appear at any such entry, independently
of the number of initialized work axes. -/
theorem extracted_sixteenth_ne {K P : Type*} [Field K] [Algebra ℚ K]
    [Fintype P] [DecidableEq P] {eighth sixteenth : K}
    (eight : IsPrimitiveRoot eighth 8) (sixteen : IsPrimitiveRoot sixteenth 16)
    (steps : List (Matrix P P K))
    (entries : ∀ gate ∈ steps, ∀ row col, gate row col ∈ ℚ⟮eighth⟯)
    (row col : P) : steps.prod row col ≠ sixteenth := by
  intro same
  exact primitiveSixteenth_not_in_eighth_field eight sixteen
    (same ▸ product_entries_mem ℚ⟮eighth⟯ steps entries row col)

#print axioms primitiveSixteenth_not_in_eighth_field
#print axioms extracted_sixteenth_ne
end QPTL.FiniteMatrix
