// Modified from https://github.com/quantumlib/Qualtran/blob/8db02b8b3fb39d69d2900dcc7b52d9d6a36834c3/qualtran/bloqs/arithmetic/comparison.py
// Selected symbol: GreaterThanConstant; bitsize=2, val=1
use std::state::init0;
use std::gate::x;



use kernel::kernel;

observe fn main() -> (Bit, Bit, Bit) {
    let q = join(join(init0(), x(init0())), x(init0()));
    let q = kernel(q);
    let (prefix2, w2) = split(q);
    let (w0, w1) = split(prefix2);
    (measure_z(w0), measure_z(w1), measure_z(w2))
}
