use evolution::evolve;
use std::quantum::init0;
use std::quantum::h;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;
use std::transforms::qft3;

unitary fn identity(q: Q<((Bit, Bit), (Bit, Bit))>) -> Q<((Bit, Bit), (Bit, Bit))> { q }
unitary fn square(q: Q<((Bit, Bit), (Bit, Bit))>) -> Q<((Bit, Bit), (Bit, Bit))> {
    repeat_static(2, evolve, q)
}
unitary fn fourth(q: Q<((Bit, Bit), (Bit, Bit))>) -> Q<((Bit, Bit), (Bit, Bit))> {
    repeat_static(4, evolve, q)
}

// Three phase bits, increasing bit weight. Consume them and retain the target.
pub observe fn phase3(q: Q<((Bit, Bit), (Bit, Bit))>) -> (((Bit, Bit), Bit), Q<((Bit, Bit), (Bit, Bit))>) {
    let (a, q) = qif(h(init0()), q) { 0 => identity, 1 => evolve };
    let (b, q) = qif(h(init0()), q) { 0 => identity, 1 => square };
    let (c, q) = qif(h(init0()), q) { 0 => identity, 1 => fourth };
    let (ab, c) = split(adjoint(qft3, join(join(a, b), c)));
    let (a, b) = split(ab);
    (((measure_z(a), measure_z(b)), measure_z(c)), q)
}
