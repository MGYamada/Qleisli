use std::quantum::{finish,init0,h};
isometry fn prepare(q: Q<Unit>) -> Q<Bit> { finish(q); h(init0()) }
fn invoke[const U: Op<Unit -> Bit>](q: Q<Unit>) -> Q<Bit>
requires Applicable(U) { U(q) }
pub isometry fn main(q: Q<Unit>) -> Q<Bit> { invoke[prepare](q) }
