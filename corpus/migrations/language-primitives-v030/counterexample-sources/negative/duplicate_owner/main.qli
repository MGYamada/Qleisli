// Deliberate QLI rejection fixture; not an external translation.
use std::state::init0;
use std::gate::cnot;

observe fn main() -> (Bit,Bit) {
    let q = init0();
    let (a,b) = cnot(q,q);
    (measure_z(a),measure_z(b))
}
