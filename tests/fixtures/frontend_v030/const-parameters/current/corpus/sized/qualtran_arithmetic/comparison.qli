use bitwise::xor_into;
use controls::all_ones;
use negation::invert_bits;

/// |x,y,t> -> |x,y,t xor [x=y]> with phase +1 on the entire space.
/// Compute differences into y, compare coherently, then restore y exactly.
pub unitary fn equals[const n: Nat](left: Q<Bits<n>>, y: Q<Bits<n>>, target: Q<Bit>)
    -> (Q<Bits<n>>, Q<Bits<n>>, Q<Bit>) {
    let (left,y) = xor_into[n](left,y);
    let y = invert_bits[n](y);
    let (y,target) = all_ones[n](y,target);
    let y = invert_bits[n](y);
    let (left,y) = xor_into[n](left,y);
    (left,y,target)
}
