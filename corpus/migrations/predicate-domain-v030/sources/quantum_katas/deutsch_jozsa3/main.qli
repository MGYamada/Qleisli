use std::quantum::init0;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;
use kernel::kernel;

observe fn main() -> ((CBit, CBit), CBit) {
    let q = kernel(join(join(init0(), init0()), init0()));
    let (part2, w2) = split(q);
    let (w0, w1) = split(part2);
    ((measure_z(w0), measure_z(w1)), measure_z(w2))
}
