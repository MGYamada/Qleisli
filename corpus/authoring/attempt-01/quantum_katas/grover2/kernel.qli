use std::quantum::init0;
use std::quantum::h;
use std::quantum::x;
use std::quantum::z;
use std::quantum::t;
use std::quantum::cnot;
use std::quantum::toffoli;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;
use std::routines::hadamard2;
use std::routines::reflect_uniform2;
basis fn marked(a: Bit, b: Bit) -> Bit { a and b }
pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let q = hadamard2(q);
    let q = with_computed(q, marked) { |flag| z(flag) };
    reflect_uniform2(q)
}
