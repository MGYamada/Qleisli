// Selected symbol: ReflectionUsingPrepare.reflection_around_zero


use std::gate::x;
use std::gate::z;


pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    let (a, b) = qif(a, b) { 0 => id, 1 => z };
    join(a, b)
}

/// Identity on the one-Bit target of a coherent branch.
unitary fn id(q: Q<Bit>) -> Q<Bit> { q }
