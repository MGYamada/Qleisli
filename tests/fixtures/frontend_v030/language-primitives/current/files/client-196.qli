use std::state::init0;
use std::gate::x; 
unitary fn flip(q: Q<Bit>) -> Q<Bit> { x(q) }
unitary fn invoke[const U: Op<Bit>](q: Q<Bit>) -> Q<Bit> requires Applicable(U) { U(q) }
pub observe fn f() -> Bit { measure_z(invoke[flip](init0())) }
pub observe fn main() -> Bit { f() }
