use std::quantum::{unit,finish,split,join,phase_eighth};
pub unitary fn remove(q:Q<(Unit,Bits<0>)>)->Q<Bits<0>>{let(u,a)=split(q);let()=finish(u);a}
pub unitary fn insert(a:Q<Bits<0>>)->Q<(Unit,Bits<0>)>{join(unit(()),a)}
pub unitary fn round(q:Q<(Unit,Bits<0>)>)->Q<(Unit,Bits<0>)>{let(u,a)=split(q);let()=finish(u);join(unit(()),a)}
pub unitary fn phase_remove(q:Q<(Unit,Bits<0>)>)->Q<Bits<0>>{let(u,a)=split(q);let()=finish(phase_eighth(u));a}
