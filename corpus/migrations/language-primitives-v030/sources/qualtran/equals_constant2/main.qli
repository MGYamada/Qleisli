use std::state::init0;



use kernel::kernel;

observe fn main() -> ((Bit, Bit), Bit) {
    let q = kernel(join(join(init0(), init0()), init0()));
    let (ab, c) = split(q);
    let (a, b) = split(ab);
    ((measure_z(a), measure_z(b)), measure_z(c))
}
