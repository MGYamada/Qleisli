use std::state::init0;

use std::gate::x;
use std::gate::z;
use std::gate::cnot;


pub observe fn teleport(q: Q<Bit>) -> ((Bit, Bit), Q<Bit>) {
    let (alice, bob) = cnot(h(init0()), init0());
    let (q, alice) = cnot(q, alice);
    let phase = measure_z(h(q));
    let parity = measure_z(alice);
    let bob = if phase { z(bob) } else { bob };
    let bob = if parity { x(bob) } else { bob };
    ((phase, parity), bob)
}
