use std::quantum::{init0,h,x,z,t,tdg,cnot,join,split};
use std::observe::measure_z;

basis fn z_phase(b: Bit) -> (Bit,(Bit,Bit)) { (0,(0,b)) }
meaning ZMeaning: Bit = phase_by(z_phase);
unitary fn direct_z(q: Q<Bit>) -> Q<Bit> { z(q) }
unitary fn fourth_t(q: Q<Bit>) -> Q<Bit> { repeat_static(4,t,q) }
unitary fn identity(q: Q<Bit>) -> Q<Bit> { q }
unitary fn apply_gate[static U: Op<Bit>](q: Q<Bit>) -> Q<Bit>
requires Apply(U) { U(q) }
unitary fn apply_pair[static U: Op<(Bit,Bit)>](q: Q<(Bit,Bit)>) -> Q<(Bit,Bit)>
requires Apply(U) { U(q) }

pub unitary fn probe(direct_z: Q<Bit>, q: Q<Bit>) -> Q<Bit> {
    apply_gate[bind_op(direct_z,ZMeaning)](q)
}
pub observe fn main() -> Unit { () }
