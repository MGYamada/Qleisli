use std::quantum::{init0,x}; use std::observe::measure_z;
pub observe fn f[static n: Nat]() -> Bit {
    for static i in 0..n carry b = 0 { let a = measure_z(x(init0())); yield b xor a; }
}
pub observe fn main() -> Bit { f[2]() }
