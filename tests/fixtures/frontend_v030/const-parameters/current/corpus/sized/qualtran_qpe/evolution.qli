use std::quantum::phase;
use std::registers::take_bit;
use std::registers::put_bit;

/// Transparent provider: phase exp(2*pi*i*j/2^d) on the low target bit.
/// All other target axes are preserved, including their correlations.
pub unitary fn evolve[const n: Nat, const j: Nat, const d: Nat](q: Q<Bits<n>>) -> Q<Bits<n>>
requires n >= 1 {
    let (bit,rest) = take_bit[n,0](q);
    let bit = phase[j,d](bit);
    put_bit[n,0](bit,rest)
}
