use std::state::init0;
use std::gate::x;



use kernel::kernel;

observe fn main() -> (((Bit, Bit), Bit), Bit) {
    let q = kernel(join(join(join(init0(), init0()), init0()), x(init0())));
    let (part3, d) = split(q);
    let (part2, c) = split(part3);
    let (a, b) = split(part2);
    (((measure_z(a), measure_z(b)), measure_z(c)), measure_z(d))
}
