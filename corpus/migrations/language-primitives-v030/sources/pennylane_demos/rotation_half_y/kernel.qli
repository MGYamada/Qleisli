use std::gate::s;

use std::gate::x;
use std::gate::z;
unitary fn rx(q: Q<Bit>) -> Q<Bit> { adjoint(global_phase_eighth)(h(s(h(q)))) }



pub unitary fn kernel(q: Q<Bit>) -> Q<Bit> {
    x(z(rx(q)))
}
