use std::gate::swap;

pub unitary fn swap_registers[const n: Nat](a: Q<Bits<n>>, b: Q<Bits<n>>) -> (Q<Bits<n>>, Q<Bits<n>>) {
    qfor static i in 0..n carry (a,b) = (a,b) {
        let (x,a) = take_bit[n,i](a);
        let (y,b) = take_bit[n,i](b);
        let (x,y) = swap(x,y);
        yield (put_bit[n,i](x,a), put_bit[n,i](y,b));
    }
}
