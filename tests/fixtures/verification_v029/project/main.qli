use std::quantum::init0;
use std::quantum::t;
use std::observe::measure_z;

// Deliberately unreachable from main: selected checking must still visit it.
unitary fn unused_phase(q: Q<Bit>) -> Q<Bit> { t(t(q)) }
observe fn main() -> CBit { measure_z(init0()) }
