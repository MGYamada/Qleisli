#![no_implicit_prelude]
classical fn mark(bit: Bit) -> Bit { bit }
isometry fn zero() -> Q<Bit> { basis unit(()) as _ {0} }
observe fn main() -> Bit {
    let q = with_computed(h(zero()), mark) { |flag| phase[1,1](flag) };
    let q = clean(q, h) { |data, scratch| (h(data), scratch) };
    measure_z(q)
}
