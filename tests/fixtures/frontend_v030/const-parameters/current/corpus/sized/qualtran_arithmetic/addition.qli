// Adapted from retained Qualtran AddK/Equals; see README.md.
use increment::increment;

/// Add K modulo 2^n, retaining arbitrary phases and correlations.
/// This reference construction repeats a shared increment; its cost depends on K.
pub unitary fn add_k[const n: Nat, const K: Nat](q: Q<Bits<n>>) -> Q<Bits<n>> {
    qfor static k in 0..K carry register = q {
        yield increment[n](register);
    }
}
