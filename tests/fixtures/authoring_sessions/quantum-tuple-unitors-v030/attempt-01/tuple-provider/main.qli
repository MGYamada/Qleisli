unitary fn identity(q:Q<(Unit,Bit)>)->Q<(Unit,Bit)>{q}
unitary fn apply[static U:Op<(Unit,Bit)>](q:Q<(Unit,Bit)>)->Q<(Unit,Bit)> requires Apply(U){U(q)}
pub unitary fn f(q:Q<(Unit,Bit)>)->Q<(Unit,Bit)>{apply[identity](q)}

observe fn main()->Unit{()}
