+    fn runtime_provider_type(&mut self, id: usize, span: Span) -> Result<SourceType> {
+        let definition = &self.definitions[id];
+        let cells = definition.inputs.iter().fold(
+            definition.output.ty.cells().saturating_mul(2).saturating_add(1),
+            |cells, input| cells.saturating_add(input.ty.cells()),
