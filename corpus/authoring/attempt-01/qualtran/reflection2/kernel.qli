use std::quantum::init0;
use std::quantum::h;
use std::quantum::x;
use std::quantum::z;
use std::quantum::t;
use std::quantum::cnot;
use std::quantum::toffoli;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;
use std::routines::hadamard2;
basis fn zero(a: Bit, b: Bit) -> Bit { not a and not b }
pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let q = hadamard2(q);
    let q = with_computed(q, zero) { |flag| z(flag) };
    hadamard2(q)
}
