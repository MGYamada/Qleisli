unitary fn apply_gate[static U: Op<Unit>](q: Q<Unit>) -> Q<Unit>
requires Apply(U) { U(q) }
pub unitary fn hidden(q: Q<Unit>) -> Q<Unit> {
    let captured = ((),q);
    apply_gate[captured](q)
}
pub observe fn main() -> Unit { () }
