// Modified from https://github.com/PennyLaneAI/demos/blob/3a04df83a16af3a2f0fd9398c0b5cc2c060ebedd/demonstrations_v2/tutorial_qaoa_maxcut/demo.py
// Selected symbols: U_C, U_B; graph=[(0,1)], gamma=pi/2, beta=pi/4
use std::quantum::h;
use std::quantum::s;
use std::quantum::phase_eighth;
use std::quantum::cnot;
use std::quantum::split;
use std::quantum::join;

unitary fn rz(q: Q<Bit>) -> Q<Bit> { adjoint(phase_eighth)(s(q)) }
unitary fn rx(q: Q<Bit>) -> Q<Bit> { h(rz(h(q))) }
pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    let (a, b) = cnot(a, b);
    let (a, b) = cnot(a, rz(b));
    join(rx(a), rx(b))
}
