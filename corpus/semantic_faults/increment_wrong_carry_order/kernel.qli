// Selected symbol: AddK; bitsize=3, k=1
use std::quantum::x;
use std::quantum::cnot;
use std::quantum::toffoli;
use std::quantum::split;
use std::quantum::join;

pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, c) = split(q);
    let (a, b) = split(ab);
    let (a, b) = cnot(a, b);
    let ((a, b), c) = toffoli(a, b, c);
    join(join(x(a), b), c)
}
