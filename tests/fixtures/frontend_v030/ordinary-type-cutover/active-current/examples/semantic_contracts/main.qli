use std::quantum::init0;
use std::quantum::h;
use std::quantum::x;
use std::quantum::z;
use std::observe::measure_z;

basis fn copy_bit(value: Bit) -> Bit { value }

// The logical meanings are specified independently of the auxiliary bodies.
unitary fn logical_identity(q: Q<Bit>) -> Q<Bit> { q }
unitary fn logical_phase(q: Q<Bit>) -> Q<Bit> { z(q) }
unitary fn logical_flip(q: Q<Bit>) -> Q<Bit> {
    do value <- q;
    pure not value
}

unitary fn phase_oracle(q: Q<Bit>) -> Q<Bit> {
    with_computed(q, copy_bit, logical_phase) { |data, auxiliary|
        (data, z(auxiliary))
    }
}

unitary fn auxiliary_identity(q: Q<Bit>) -> Q<Bit> {
    with_computed(q, copy_bit, logical_identity) { |data, auxiliary|
        (data, h(h(auxiliary)))
    }
}

unitary fn correlated_flip(q: Q<Bit>) -> Q<Bit> {
    with_computed(q, copy_bit, logical_flip) { |data, auxiliary|
        (x(data), x(auxiliary))
    }
}

observe fn main() -> ((Bit, Bit), Bit) {
    let phase = measure_z(h(phase_oracle(h(init0()))));
    let identity = measure_z(h(auxiliary_identity(h(init0()))));
    let flip = measure_z(correlated_flip(init0()));
    ((phase, identity), flip)
}
