use std::quantum::{init0,h,x,z,t,tdg,cnot,join,split};
use std::observe::measure_z;

basis fn z_phase(b: Bit) -> (Bit,(Bit,Bit)) { (0,(0,b)) }
meaning ZMeaning: Bit = phase_by(z_phase);
unitary fn direct_z(q: Q<Bit>) -> Q<Bit> { z(q) }
unitary fn fourth_t(q: Q<Bit>) -> Q<Bit> { repeat_static(4,t,q) }
unitary fn identity(q: Q<Bit>) -> Q<Bit> { q }
unitary fn apply_gate[static U: Op<Bit>](q: Q<Bit>) -> Q<Bit>
requires Apply(U) { U(q) }
unitary fn apply_pair[static U: Op<(Bit,Bit)>](q: Q<(Bit,Bit)>) -> Q<(Bit,Bit)>
requires Apply(U) { U(q) }

pub unitary fn probe(q: Q<Bit>) -> Q<Bit> {
    apply_gate[checked_op(direct_z,ZMeaning)](q)
}
pub observe fn main() -> (Bit,Bit,Bit) {
    let c = h(init0());
    let (r,q) = cnot(t(h(init0())),init0());
    let q = apply_gate[checked_op(direct_z,ZMeaning)](q);
    let pair = apply_pair[controlled_op(checked_op(fourth_t,ZMeaning))](join(c,q));
    let (c,q) = split(pair);
    // Independent explicit inverse uses the sealed Z action, not checked evidence.
    let (c,q) = qif(c,q) { 0 => identity, 1 => direct_z };
    let q = z(q);
    let (r,q) = cnot(r,q);
    (measure_z(h(c)),measure_z(h(tdg(r))),measure_z(q))
}
