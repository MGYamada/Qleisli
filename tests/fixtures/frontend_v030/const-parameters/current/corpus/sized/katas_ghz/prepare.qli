// Modified from the pinned GHZ_State_Reference; see ../README.md.
use std::quantum::h;
use std::quantum::cnot;
use std::registers::take_bit;
use std::registers::put_bit;

/// H on the low bit followed by a fanout of coherent controlled X operations.
/// On all-zero input this prepares (|0...0> + |1...1>)/sqrt(2).
/// On general inputs it remains this full unitary, with no zero-input promise.
pub unitary fn ghz[const n: Nat](q: Q<Bits<n>>) -> Q<Bits<n>> requires n >= 1 {
    let (head,tail) = take_bit[n,0](q);
    let head = h(head);
    let (head,tail) = qfor static k in 0..n-1 carry pair = (head,tail) {
        let (head,tail) = pair;
        let (bit,tail) = take_bit[n-1,k](tail);
        let (head,bit) = cnot(head,bit);
        yield (head,put_bit[n-1,k](bit,tail));
    };
    put_bit[n,0](head,tail)
}
