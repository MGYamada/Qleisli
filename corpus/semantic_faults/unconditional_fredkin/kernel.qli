use std::quantum::cnot;
use std::quantum::join;
use std::quantum::split;

unitary fn identity(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> { q }
unitary fn swap_pair(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    let (a, b) = cnot(a, b);
    let (b, a) = cnot(b, a);
    let (a, b) = cnot(a, b);
    join(a, b)
}
pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ca, b) = split(q);
    let (control, a) = split(ca);
    let (control, targets) = qif(control, join(a, b)) { 0 => swap_pair, 1 => swap_pair };
    let (a, b) = split(targets);
    join(join(control, a), b)
}
