use std::gate::{cnot, x};
unitary fn logical(q: Q<Bit>) -> Q<Bit> { x(q) }
pub unitary fn main(q: Q<Bit>, d: Q<Bit>) -> (Q<Bit>, Q<Bit>) {
    dirty(q, d, logical) { |data, scratch|
        let (data, scratch) = cnot(data, scratch);
        let (data, scratch) = cnot(x(data), scratch);
        (data, x(scratch))
    }
}
