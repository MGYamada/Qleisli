use std::gate::x;
use std::gate::cnot;



pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    // Flip the low bit before using it to propagate the borrow.
    let (a, b) = cnot(a, b);
    join(x(a), b)
}

// Deliberate local semantic mutation: Propagate the old low bit instead of the complemented bit, implementing increment instead of decrement.
