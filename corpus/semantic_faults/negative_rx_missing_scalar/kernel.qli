// Selected symbol(s): circuit(params)
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::h;
use std::quantum::t;

basis fn one(a: Bit) -> Bit { 1 }
unitary fn scalar(q: Q<Bit>) -> Q<Bit> {
    with_computed(q, one) { |flag| t(t(t(t(t(t(t(flag))))))) }
}
unitary fn rz_quarter(q: Q<Bit>) -> Q<Bit> { repeat_static(2, t, q) }
pub unitary fn kernel(q: Q<Bit>) -> Q<Bit> { h(adjoint(rz_quarter, h(q))) }

// Deliberate local semantic mutation: Erase the RZ completion scalar: basis probabilities still agree, but controlled phase differs.
