#![no_implicit_prelude]
pub enum Flag { Down, Up }
classical fn to_flag(b: Bit) -> Flag { if b { Flag::Up } else { Flag::Down } }
isometry fn encode(q: Q<Bit>) -> Q<Flag> {
    basis q as b { to_flag(b) }
}
isometry fn decode(q: Q<Flag>) -> Q<Bit> {
    basis q as flag { match flag { Flag::Down => 1, Flag::Up => 0 } }
}
meaning Encode: Bit -> Flag = reference(encode);
meaning Decode: Flag -> Bit = reference(decode);
meaning Flip: Bit = compose(Encode, Decode);
unitary fn flip(q: Q<Bit>) -> Q<Bit> { basis q as b { not b } }
pub unitary fn undo(q: Q<Bit>) -> Q<Bit> { adjoint(checked_op(flip, Flip))(q) }
