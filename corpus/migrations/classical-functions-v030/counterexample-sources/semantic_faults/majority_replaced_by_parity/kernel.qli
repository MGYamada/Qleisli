// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::h;
use std::quantum::z;
use std::quantum::join;
use std::quantum::split;

classical fn majority(((a, b), c): ((Bit, Bit), Bit)) -> Bit {
    a xor b xor c
}
unitary fn hadamards(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, c) = split(q);
    let (a, b) = split(ab);
    join(join(h(a), h(b)), h(c))
}
pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let q = hadamards(q);
    let q = with_computed(q, majority) { |flag| z(flag) };
    hadamards(q)
}
