// Selected symbol: U_C(gamma), single-edge factor; gamma=pi
use std::quantum::init0;
use std::quantum::x;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;
use kernel::kernel;

observe fn main() -> (Bit, Bit) {
    let q = join(init0(), x(init0()));
    let q = kernel(q);
    let (w0, w1) = split(q);
    (measure_z(w0), measure_z(w1))
}
