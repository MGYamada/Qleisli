use std::quantum::{init0, h};
use std::observe::{measure_z, discard};
observe fn main() -> CBit {
    let c = measure_z(h(init0()));
    if c {
        let d = measure_z(h(init0()));
        if d {
            let a = init0();
            let b = init0();
            discard(a);
            discard(b);
            true
        } else { true }
    } else { true }
}
