/// Explicit two-axis representation reordering, with old/new map [1,0].
/// Consume the pair and return every owner in reversed axis order, phase +1.
/// Split/join changes output wire order and inserts no physical SWAP gate.
/// This is not binding exchange; actual target routing costs remain separate.
pub unitary fn permute_axes(q: Q<(Bit,Bit)>) -> Q<(Bit,Bit)> {
    let (a,b) = split(q);
    join(b,a)
}

/// Introduce exactly one Q<Bits<0>> owner, with coefficient +1 and no physical wire.
/// Bits<0> remains distinct from Unit; this creates no classical value or state promise.
pub unitary fn empty() -> Q<Bits<0>> {
    basis unit(()) as _ { empty_bits() }
}

/// Consume exactly Q<Bits<0>>, preserving the complete scalar phase and references.
/// This is a structural owner transition, not observation, discard or reset.
pub unitary fn consume_empty(q: Q<Bits<0>>) -> Unit {
    finish(basis q as _ { () })
}
