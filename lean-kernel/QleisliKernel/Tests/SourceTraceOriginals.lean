  ("std::measurement","//! Complete measurement instruments, implemented as ordinary checked source.\n//!\n//! Logical owners and external-reference behavior follow each declared contract.\n//! Contract identifiers: R003-R005.\nuse std::state::init0;\nuse std::gate::cnot;\n\n/// Measure the X eigenvalue (-1)^b and return the classical result b.\n/// Consume the target owner; interpret the measurement with all references.\npub observe fn measure_x(q: Q<Bit>) -> Bit {\n    measure_z(h(q))\n}\n\n/// Measure both bits in Z and consume both quantum owners.\n/// Return (left result, right result), corresponding to register weights 1,2.\npub observe fn measure_z2(q: Q<(Bit, Bit)>) -> (Bit, Bit) {\n    let (a, b) = split(q);\n    (measure_z(a), measure_z(b))\n}\n\n/// Measure Z(a) Z(b), consuming the internal meter and returning both data owners.\n/// For result s, the data projector is (I + (-1)^s Z tensor Z)/2.\n/// Preserve coherence within each parity subspace and return ((a,b),s).\n/// Inputs must be distinct owners, but may be entangled with each other or a reference.\npub observe fn parity_zz(a: Q<Bit>, b: Q<Bit>) -> ((Q<Bit>, Q<Bit>), Bit) {\n    let meter = init0();\n    let (a, meter) = cnot(a, meter);\n    let (b, meter) = cnot(b, meter);\n    ((a, b), measure_z(meter))\n}\n"),
