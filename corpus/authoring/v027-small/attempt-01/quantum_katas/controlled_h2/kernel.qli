// Selected symbol: ControlledRotation_Reference
use std::quantum::h;
use std::quantum::id;
use std::quantum::split;
use std::quantum::join;

pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    let (a, b) = qif(h(a), b, id, h);
    join(a, b)
}
