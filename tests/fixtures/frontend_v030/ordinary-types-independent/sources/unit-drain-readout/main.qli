use std::registers::consume_empty; use std::observe::measure_z; use std::classical::empty_bits; use std::classical::prepend_bit; unitary fn drain(z: Q<Bits<0>>) -> Unit { consume_empty(z) } pub observe fn f(z: Q<Bits<0>>,q: Q<Bit>) -> Bits<1> { let u = drain(z); let (a,b) = (u,u); prepend_bit[0](measure_z(q),empty_bits()) }
