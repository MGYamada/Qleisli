// Selected symbol(s): QROM
// Closed observing driver, not the independent QROM specification.

use kernel::kernel;

observe fn main() -> (((Bit, Bit), Bit), Bit) {
    let q = kernel(join(join(join(init0(), init0()), init0()), init0()));
    let (part3, t1) = split(q);
    let (address, t0) = split(part3);
    let (a0, a1) = split(address);
    (((measure_z(a0), measure_z(a1)), measure_z(t0)), measure_z(t1))
}
