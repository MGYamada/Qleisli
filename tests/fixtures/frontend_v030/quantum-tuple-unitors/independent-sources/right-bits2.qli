use std::quantum::{unit,finish,split,join,phase_eighth};
pub unitary fn remove(q:Q<(Bits<2>,Unit)>)->Q<Bits<2>>{let(a,u)=split(q);let()=finish(u);a}
pub unitary fn insert(a:Q<Bits<2>>)->Q<(Bits<2>,Unit)>{join(a,unit(()))}
pub unitary fn round(q:Q<(Bits<2>,Unit)>)->Q<(Bits<2>,Unit)>{let(a,u)=split(q);let()=finish(u);join(a,unit(()))}
pub unitary fn phase_remove(q:Q<(Bits<2>,Unit)>)->Q<Bits<2>>{let(a,u)=split(q);let()=finish(phase_eighth(u));a}
