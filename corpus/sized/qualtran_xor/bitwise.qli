// Modified from the pinned Qualtran Xor decomposition; see ../README.md.
use std::quantum::cnot;
use std::registers::take_bit;
use std::registers::put_bit;

/// Preserve x and coherently XOR its corresponding bits into y, with phase +1.
/// The empty fold returns both distinct zero-width owners.
pub unitary fn xor_into[static n: Nat](x: Q<Bits<n>>, y: Q<Bits<n>>)
    -> (Q<Bits<n>>, Q<Bits<n>>) {
    for static k in 0..n carry pair = (x,y) {
        let (x,y) = pair;
        let (a,x) = take_bit[n,k](x);
        let (b,y) = take_bit[n,k](y);
        let (a,b) = cnot(a,b);
        yield (put_bit[n,k](a,x),put_bit[n,k](b,y));
    }
}
