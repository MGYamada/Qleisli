use std::quantum::phase_eighth;
use std::observe::measure_z;
use std::classical::{empty_bits,prepend_bit};
pub observe fn f(q: Q<Unit>,c: Q<Bit>) -> (Bits<1>,Q<Unit>) { let b = measure_z(c); let q = phase_eighth(q); (prepend_bit[0](b,empty_bits()),q) }
