// A valid private source declaration supplies the finite eligibility barrier.
fn eligibility_barrier[static A: Basis](q: Q<A>) -> Q<A> { q }
fn forwards[static U: Op<Bit>](q: Q<Bit>) -> Q<Bit>
requires Apply(U) { U(q) }
fn apply[static W: Op<Bit>](q: Q<Bit>) -> Q<Bit>
requires Apply(W) { W(q) }
pub fn probe[static V: Op<Bit>](q: Q<Bit>) -> Q<Bit>
requires Apply(V) { apply[forwards[V]](q) }
