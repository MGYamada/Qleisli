// A valid private source declaration supplies the finite eligibility barrier.
fn eligibility_barrier[const A: Basis](q: Q<A>) -> Q<A> { q }
fn forwards[const U: Op<Bit>](q: Q<Bit>) -> Q<Bit>
requires Apply(U) { U(q) }
fn apply[const W: Op<Bit>](q: Q<Bit>) -> Q<Bit>
requires Apply(W) { W(q) }
pub fn probe[const V: Op<Bit>](q: Q<Bit>) -> Q<Bit>
requires Apply(V) { apply[forwards[V]](q) }
