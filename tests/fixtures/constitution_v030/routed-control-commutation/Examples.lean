private def bSecond : Stage := ⟨20,21,22,23,28,29,ba.definitions[21],ba.definitions[23],ba.definitions[29]⟩
private def aSpine : Spine := ⟨31,ab.definitions[31],aFirst,aSecond,24,27,30⟩
private def bSpine : Spine := ⟨31,ba.definitions[31],bFirst,bSecond,24,27,30⟩

