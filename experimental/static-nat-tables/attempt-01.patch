+//! Original-source finite Nat tables; never runtime data or semantic evidence.
+// Copyright 2026 Masahiko G. Yamada. SPDX-License-Identifier: Apache-2.0.
+use super::super::ast::{NatKind, Natural};
+use super::super::resolve::locals::ResolvedUse;
+use super::*;
+
+#[derive(Debug)]
+pub(in crate::frontend) struct Table {
+    pub length: Linear,
+    pub elements: Elements,
+}
+#[derive(Debug)]
+pub(in crate::frontend) enum Elements {
+    Literal(Vec<Linear>),
+    Generate { index: BinderKey, start: Linear, value: Linear },
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::frontend::parser::parse_module;
+
+    fn check(source: &str) -> Result<()> {
+        let syntax = parse_module(source).unwrap();
+        program_with(BTreeMap::from([("main", &syntax)]), SourceLimits::selected(),
+            |_, _, _, _, _, _| Ok(())).map(|_| ())
+    }
+
+    #[test]
+    fn original_table_definitions_check_lengths_lookup_and_generic_equalities() {
+        for source in [
+            "static fn values[static n:Nat]()->[Nat;n]{for static i in 0..n{yield i+1;}} pub fn f[static n:Nat,static k:Nat]()->Bit requires k<n {static let v=values[n]();if static v[k]==k+1{1}else{0}}",
+            "static fn values[static n:Nat]()->[Nat;2]{[n,n+1]} pub unitary fn f[static n:Nat](q:Q<Bits<n+1>>)->Q<Bits<n+1>>{static let v=values[n]();g[v[1]](q)} pub unitary fn g[static m:Nat](q:Q<Bits<m>>)->Q<Bits<m>>{q}",
+            "static fn values()->[Nat;3]{[1,2,3]} pub fn f[static i:Nat]()->Bit requires i<3 {static let v=values();if static v[i]==i+1{1}else{0}}",
+            "static fn first[static n:Nat]()->[Nat;n]{for static i in 0..n{yield i+1;}} static fn second[static n:Nat]()->[Nat;n]{first[n]()} pub fn f()->Bit{static let v=second[1]();static let k=v[0];0}",
+            "static fn empty()->[Nat;0]{for static i in 0..0{yield i+1;}} pub fn f()->Bit{static let v=empty();0}",
+            "pub fn f()->Bit{static let v=[1,2,3];static let alias=v;static let k=alias[2];0}",
+        ] { check(source).unwrap_or_else(|e| panic!("{source}: {e}")); }
+    }
+
+    #[test]
+    fn invalid_unused_empty_and_staged_original_occurrences_reject() {
+        for (source, code) in [
+            ("static fn bad()->[Nat;2]{[1]} pub fn f()->Bit{0}", "size"),
+            ("static fn empty()->[Nat;0]{[]} pub fn f()->Bit{static let v=empty();static let k=v[0];0}", "size"),
+            ("pub fn f()->Bit{static let v=[1,2];static let k=v[2];0}", "size"),
+            ("static fn values[static n:Nat]()->[Nat;n]{for static i in 0..n{yield i+1;}} pub fn f[static n:Nat,static k:Nat]()->Bit{static let v=values[n]();static let bad=v[k];0}", "size"),
+            ("static fn empty()->[Nat;0]{for static i in 0..0{yield missing;}} pub fn f()->Bit{0}", "static"),
+            ("static fn empty()->[Nat;0]{for static i in 0..0{yield 0-1;}} pub fn f()->Bit{0}", "size"),
+            ("pub fn f(b:Bit)->Bit{static let v=[b];b}", "static"),
+            ("pub unitary fn f(q:Q<Bit>)->Q<Bit>{static let v=[q];q}", "static"),
+            ("pub fn f()->Bit{static let v=[1];v}", "static"),
+            ("static fn first()->[Nat;1]{second()} static fn second()->[Nat;1]{first()} pub fn f()->Bit{0}", "cycle"),
+            ("static fn scalar()->Nat{[1]} pub fn f()->Bit{0}", "static"),
+            ("static fn table()->[Nat;1]{1} pub fn f()->Bit{0}", "static"),
+            ("pub fn f()->Bit{static let v=[[1]];0}", "static"),
+            ("pub fn f[static i:Nat]()->Bit requires i<3 {static let v=[0,1,4];static let k=v[i];0}", "unsupported"),
+        ] {
+            let e = check(source).unwrap_err();
+            assert_eq!(e.code, code, "{source}: {e}");
+        }
+    }
+
+    #[test]
+    fn index_diagnostic_names_the_actual_index_expression() {
+        let source = "pub fn f()->Bit{static let values=[1,2];static let bad=values[1+1];0}";
+        let e = check(source).unwrap_err();
+        assert_eq!(e.code, "size");
+        assert_eq!(&source[e.span.start..e.span.end], "1+1");
+    }
+}
+
+pub(super) fn value(n: &Natural, index: &Index<'_>, scope: &Scope, budget: &Budget) -> Result<StaticValue> {
+    budget.charge(n.span, 1)?;
+    let mut charge = |s, c| budget.sized_charge(s, c);
+    let table = match &n.kind {
+        NatKind::Call { .. } => return normalize::helper(n, index, scope, None, budget, 1),
+        NatKind::Name(_) => {
+            if let ResolvedUse::Local(id) = index.table.usage(index.natural_usage(n)).target {
+                if let Some(table) = scope.tables.get(index.table.key(id)) {
+                    return Ok(StaticValue::Array(Arc::clone(table)));
+                }
+            }
+            return normalize::natural(n, index, scope, None, budget).map(StaticValue::Natural);
+        }
+        NatKind::Array(values) => {
+            budget.charge(n.span, values.len())?;
+            let mut elements = Vec::with_capacity(values.len());
+            for element in values {
+                elements.push(normalize::natural(element, index, scope, None, budget)?);
+            }
+            Table { length: Linear::constant_budgeted(values.len() as i128, n.span, &mut charge)?, elements: Elements::Literal(elements) }
+        }
+        NatKind::Generate { index: binder, start, end, value } => {
+            let info = index.table.binder(index.binder(binder));
+            if info.shadowed.is_some() {
+                return Err(SourceError::new("shadow", binder.span, "static generator index cannot shadow a visible binding"));
+            }
+            let start = normalize::natural(start, index, scope, None, budget)?;
+            let end = normalize::natural(end, index, scope, None, budget)?;
+            if !scope.context.proves_le_budgeted(&start, &end, n.span, "static generator requires start <= end", &mut charge)? {
+                return Err(SourceError::new("size", n.span, "static generator requires start <= end"));
+            }
+            let length = end.sub_budgeted(&start, n.span, &mut charge)?;
+            let key = budget.key(binder.span, &info.key)?;
+            let i = Linear::variable_budgeted(&key, binder.span, &mut charge)?;
+            let mut inner = scope.basis_scope(budget, n.span)?;
+            // Always check the original body. A provably empty range cannot
+            // supply contradictory bounds as a vacuous arithmetic discharge.
+            let zero = Linear::constant_budgeted(0, n.span, &mut charge)?;
+            let mut bounds = vec![zero.sub_budgeted(&i, n.span, &mut charge)?];
+            if !scope.context.proves_le_budgeted(&end, &start, n.span, "checking empty generator range", &mut charge)? {
+                let one = Linear::constant_budgeted(1, n.span, &mut charge)?;
+                budget.charge(n.span, 2)?;
+                bounds.push(start.sub_budgeted(&i, n.span, &mut charge)?);
+                bounds.push(i.add_budgeted(&one, n.span, &mut charge)?.sub_budgeted(&end, n.span, &mut charge)?);
+            }
+            inner.context = inner.context.push_budgeted(&bounds, n.span, &mut charge)?;
+            inner.naturals.insert(budget.key(binder.span, &key)?, i);
+            let result = normalize::natural(value, index, &inner, None, budget)?;
+            Table { length, elements: Elements::Generate { index: key, start, value: result } }
+        }
+        _ => return normalize::natural(n, index, scope, None, budget).map(StaticValue::Natural),
+    };
+    budget.charge(n.span, 1)?;
+    Ok(StaticValue::Array(Arc::new(table)))
+}
+
+pub(super) fn substitute(value: &StaticValue, actual: &BTreeMap<BinderKey, Linear>, span: Span, budget: &Budget) -> Result<StaticValue> {
+    let mut charge = |s, c| budget.sized_charge(s, c);
+    let sub = |linear: &Linear, charge: &mut _| linear.substitute_budgeted(actual, span, charge);
+    Ok(match value {
+        StaticValue::Natural(n) => StaticValue::Natural(sub(n, &mut charge)?),
+        StaticValue::Array(table) => {
+            let length = sub(&table.length, &mut charge)?;
+            let elements = match &table.elements {
+                Elements::Literal(values) => {
+                    budget.charge(span, values.len())?;
+                    let mut result = Vec::with_capacity(values.len());
+                    for v in values { result.push(sub(v, &mut charge)?); }
+                    Elements::Literal(result)
+                }
+                Elements::Generate { index, start, value } => Elements::Generate {
+                    index: budget.key(span, index)?, start: sub(start, &mut charge)?, value: sub(value, &mut charge)?,
+                },
+            };
+            budget.charge(span, 1)?;
+            StaticValue::Array(Arc::new(Table { length, elements }))
+        }
+    })
+}
+
+pub(super) fn lookup(name: &ast::Ident, position: &Linear, span: Span, index: &Index<'_>, scope: &Scope, budget: &Budget) -> Result<Linear> {
+    let table = normalize::local(index, name).and_then(|key| scope.tables.get(key)).ok_or_else(|| {
+        SourceError::new("static", name.span, "static indexing requires a lexical Nat array binding")
+    })?;
+    let mut charge = |s, c| budget.sized_charge(s, c);
+    let zero = Linear::constant_budgeted(0, span, &mut charge)?;
+    let successor = position.add_budgeted(&Linear::constant_budgeted(1, span, &mut charge)?, span, &mut charge)?;
+    if !scope.context.proves_le_budgeted(&zero, position, span, "static index must be nonnegative", &mut charge)?
+        || !scope.context.proves_le_budgeted(&successor, &table.length, span, "static index must be below the array length", &mut charge)? {
+        return Err(SourceError::new("size", span, "static Nat array index is not proved in range"));
+    }
+    match &table.elements {
+        Elements::Generate { index, start, value } => {
+            let actual = position.add_budgeted(start, span, &mut charge)?;
+            budget.charge(span, 1)?;
+            value.substitute_budgeted(&BTreeMap::from([(budget.key(span, index)?, actual)]), span, &mut charge).map_err(Into::into)
+        }
+        Elements::Literal(values) => {
+            for (ordinal, value) in values.iter().enumerate() {
+                budget.charge(span, 1)?;
+                let ordinal = Linear::constant_budgeted(ordinal as i128, span, &mut charge)?;
+                if scope.context.proves_le_budgeted(position, &ordinal, span, "resolving literal array index", &mut charge)?
+                    && scope.context.proves_le_budgeted(&ordinal, position, span, "resolving literal array index", &mut charge)? {
+                    return value.copy_budgeted(span, &mut charge).map_err(Into::into);
+                }
+            }
+            // Symbolic literal lookup remains affine only when the entire
+            // literal table has the same exact affine law in its index.
+            let Some((first, rest)) = values.split_first() else {
+                return Err(SourceError::new("size", span, "an empty Nat array has no element"));
+            };
+            let delta = if let Some(second) = rest.first() { second.sub_budgeted(first, span, &mut charge)? } else { zero };
+            if !delta.terms.is_empty() {
+                return Err(SourceError::new("unsupported", span, "symbolic literal lookup is not an affine Nat expression"));
+            }
+            for (ordinal, element) in values.iter().enumerate() {
+                let term = delta.scale_budgeted(ordinal as i128, span, &mut charge)?;
+                let expected = first.add_budgeted(&term, span, &mut charge)?;
+                if !scope.context.proves_le_budgeted(&expected, element, span, "checking literal lookup law", &mut charge)?
+                    || !scope.context.proves_le_budgeted(element, &expected, span, "checking literal lookup law", &mut charge)? {
+                    return Err(SourceError::new("unsupported", span, "symbolic literal lookup is not an affine Nat expression"));
+                }
+            }
+            first.add_budgeted(&position.scale_budgeted(delta.constant, span, &mut charge)?, span, &mut charge).map_err(Into::into)
+        }
+    }
+}
