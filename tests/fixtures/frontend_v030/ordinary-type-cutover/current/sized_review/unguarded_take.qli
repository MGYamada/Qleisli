// First rejected source: generic n admits zero, but take_bit needs 0 < n.
// Copyright 2026 Masahiko G. Yamada. SPDX-License-Identifier: Apache-2.0
use std::registers::take_bit;
use std::registers::put_bit;
pub unitary fn f[static n: Nat](q: Q<Bits<n>>) -> Q<Bits<n>> {
    let (head,tail) = take_bit[n,0](q);
    put_bit[n,0](head,tail)
}
