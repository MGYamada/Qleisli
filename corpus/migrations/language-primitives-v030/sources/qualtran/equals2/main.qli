use std::state::init0;



use kernel::kernel;
use std::gate::x;

observe fn main() -> ((((Bit, Bit), Bit), Bit), Bit) {
    let q = kernel(join(join(join(join(x(init0()), init0()), x(init0())), init0()), x(init0())));
    let (part4, w4) = split(q);
    let (part3, w3) = split(part4);
    let (part2, w2) = split(part3);
    let (w0, w1) = split(part2);
    ((((measure_z(w0), measure_z(w1)), measure_z(w2)), measure_z(w3)), measure_z(w4))
}
