use std::quantum::phase;
static fn denominators[static n:Nat]()->[Nat;n]{for static i in 0..n{yield i+1;}}
pub unitary fn schedule[static n:Nat](q:Q<Bit>)->Q<Bit> requires n<=3 {static let ks=denominators[n]();qfor static i in 0..n carry r=q{yield phase[1,ks[i]](r);}}
pub observe fn main()->Bit{measure_z(schedule[3](prepare(1)))}
