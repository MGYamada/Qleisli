//! A superposed target yields the joint phase/eigenstate instrument, not one phase.
use estimation::phase3;
use gates::eighth_phase;
use std::quantum::init0;
use std::quantum::h;
use std::quantum::cnot;
use std::observe::measure_z;
observe fn main() -> (((CBit,CBit),CBit),(CBit,CBit)) {
    let (reference,target) = cnot(h(init0()),init0());
    let (word,target) = phase3[eighth_phase](target);
    (word,(measure_z(reference),measure_z(target)))
}
