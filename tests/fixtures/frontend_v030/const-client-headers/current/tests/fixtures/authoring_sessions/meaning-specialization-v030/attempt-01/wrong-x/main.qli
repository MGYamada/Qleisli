use std::quantum::x;
classical fn flip(b:Bit)->Bit {not b}
meaning Flip:Bit=permutation_by(flip);
pub unitary fn implementation(q:Q<Bit>)->Q<Bit>{q}
pub unitary fn client[const U:Op<Bit,Flip>](q:Q<Bit>)->Q<Bit> requires Apply(U) {U(q)}
unitary fn bound(q:Q<Bit>)->Q<Bit>{client[implementation](q)}
observe fn main()->Unit{()}
