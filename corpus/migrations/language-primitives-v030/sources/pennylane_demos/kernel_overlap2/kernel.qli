// Selected symbol(s): kernel
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::gate::s;


use std::gate::t;



unitary fn rx_quarter(q: Q<Bit>) -> Q<Bit> {
    h(adjoint(global_phase_eighth)(s(h(q))))
}
unitary fn left_features(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    join(power(rx_quarter, 2)(a), rx_quarter(b))
}
unitary fn right_features(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    join(rx_quarter(a), b)
}
pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    adjoint(right_features)(left_features(q))
}
