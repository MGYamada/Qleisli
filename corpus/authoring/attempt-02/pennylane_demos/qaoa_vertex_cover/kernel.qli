// Selected symbol(s): qaoa_layer; circuit
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::init0;
use std::quantum::h;
use std::quantum::x;
use std::quantum::z;
use std::quantum::t;
use std::quantum::cnot;
use std::quantum::toffoli;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;
basis fn one(a: Bit) -> Bit { 1 }
// This scalar is needed: S alone is not RZ(pi/2) under control.
unitary fn scalar(q: Q<Bit>) -> Q<Bit> {
    with_computed(q, one) { |flag| t(t(t(t(t(t(t(flag))))))) }
}
unitary fn rz_quarter(q: Q<Bit>) -> Q<Bit> { scalar(repeat_static(2, t, q)) }
unitary fn rx_quarter(q: Q<Bit>) -> Q<Bit> { h(rz_quarter(h(q))) }
unitary fn ry_quarter(q: Q<Bit>) -> Q<Bit> { h(z(q)) }

pub unitary fn kernel(q: Q<(((Bit, Bit), Bit), Bit)>) -> Q<(((Bit, Bit), Bit), Bit)> {
    let (part3, d) = split(q);
    let (part2, c) = split(part3);
    let (a, b) = split(part2);
    let a = h(a);
    let b = h(b);
    let c = h(c);
    let d = h(d);
    let (a, b) = cnot(a, b);
    let b = repeat_static(3, rz_quarter, b);
    let (a, b) = cnot(a, b);
    let (b, c) = cnot(b, c);
    let c = repeat_static(3, rz_quarter, c);
    let (b, c) = cnot(b, c);
    let (c, a) = cnot(c, a);
    let a = repeat_static(3, rz_quarter, a);
    let (c, a) = cnot(c, a);
    let (c, d) = cnot(c, d);
    let d = repeat_static(3, rz_quarter, d);
    let (c, d) = cnot(c, d);
    let a = repeat_static(5, rz_quarter, a);
    let b = repeat_static(5, rz_quarter, b);
    let c = repeat_static(8, rz_quarter, c);
    let d = repeat_static(2, rz_quarter, d);
    join(join(join(rx_quarter(a), rx_quarter(b)), rx_quarter(c)), rx_quarter(d))
}
