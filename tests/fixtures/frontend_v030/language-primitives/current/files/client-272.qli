//! Current workaround for a nonconstant pair meaning: an independent circuit specification.
use std::state::init0;
use std::gate::x;
use std::gate::z;


use std::measurement::measure_z2;

classical fn marked(a: Bit, b: Bit) -> Bit { a and b }
unitary fn oracle(q: Q<(Bit,Bit)>) -> Q<(Bit,Bit)> {
    with_computed(q,marked) { |flag| z(flag) }
}
unitary fn identity(q: Q<Bit>) -> Q<Bit> { q }
unitary fn specified(q: Q<(Bit,Bit)>) -> Q<(Bit,Bit)> {
    let (a,b) = split(q);
    let (a,b) = qif(a,b) { 0 => identity, 1 => z };
    join(a,b)
}
observe fn main() -> (Bit,Bit) {
    measure_z2(apply_contract(oracle,specified,join(x(init0()),x(init0()))))
}
