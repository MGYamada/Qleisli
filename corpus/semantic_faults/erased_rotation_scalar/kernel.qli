// Selected symbol(s): kernel
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::h;
use std::quantum::t;
use std::quantum::join;
use std::quantum::split;

basis fn one(a: Bit) -> Bit { 1 }
unitary fn scalar(q: Q<Bit>) -> Q<Bit> {
    with_computed(q, one) { |flag| t(t(t(t(t(t(t(flag))))))) }
}
unitary fn rx_quarter(q: Q<Bit>) -> Q<Bit> {
    h(repeat_static(2, t, h(q)))
}
unitary fn left_features(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    join(repeat_static(2, rx_quarter, a), rx_quarter(b))
}
unitary fn right_features(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    join(rx_quarter(a), b)
}
pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    adjoint(right_features, left_features(q))
}
