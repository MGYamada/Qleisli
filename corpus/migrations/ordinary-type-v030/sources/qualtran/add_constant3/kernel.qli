// Selected symbol(s): AddK
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::x;
use std::quantum::cnot;
use std::quantum::toffoli;
use std::quantum::join;
use std::quantum::split;

pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, c) = split(q);
    let (a, b) = split(ab);
    // Add one, propagating carry before changing either lower bit.
    let ((a, b), c) = toffoli(a, b, c);
    let (a, b) = cnot(a, b);
    let a = x(a);
    // Add two to the updated register.
    let (b, c) = cnot(b, c);
    join(join(a, x(b)), c)
}
