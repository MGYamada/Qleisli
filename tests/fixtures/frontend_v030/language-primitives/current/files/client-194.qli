classical fn scalar(u:Unit)->(Bit,(Bit,Bit)){(0,(0,1))}
meaning Minus:Unit=phase_by(scalar);
pub unitary fn implementation(q:Q<Unit>)->Q<Unit>{global_phase_eighth(global_phase_eighth(global_phase_eighth(global_phase_eighth(q))))}
pub unitary fn client[const U:Op<Unit,Minus>](q:Q<Unit>)->Q<Unit> requires Applicable(U){U(q)}
observe fn main()->Unit{()}
