use std::quantum::h;
use std::quantum::z;
use std::quantum::s;
use std::quantum::sdg;
use std::quantum::split;
use std::quantum::join;

pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    join(z(h(a)), s(h(b)))
}
