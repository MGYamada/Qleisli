// Selected symbol: circuit(params); params=(pi,0)
use std::quantum::x;
use std::quantum::phase_eighth;

pub unitary fn kernel(q: Q<Bit>) -> Q<Bit> {
    adjoint(phase_eighth, adjoint(phase_eighth, x(q)))
}
