use std::quantum::split;
use std::quantum::join;
use std::quantum::id;
fn pack(q: Q<Bit>) -> (Q<Bit>,Unit) { (q,()) }
fn conditional(q: Q<(Bit,Bit)>) -> Q<(Bit,Bit)> {
    let (c,q) = split(q);
    let (c,q) = qif(c,q) { 0 => id, 1 => pack };
    join(c,q)
}
pub fn main() -> Unit { () }
