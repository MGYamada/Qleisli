use std::quantum::h;
use std::quantum::phase;
use std::registers::take_bit;
use std::registers::put_bit;

/// A = H diag(1, exp(2*pi*i*j/2^d)) H on the low bit, identity on the rest.
/// From zero, Pr[low bit=1] = sin(pi*j/2^d)^2.
pub unitary fn prepare[const n: Nat, const j: Nat, const d: Nat](q: Q<Bits<n>>) -> Q<Bits<n>>
requires n >= 1 {
    let (bit,rest) = take_bit[n,0](q);
    put_bit[n,0](h(phase[j,d](h(bit))),rest)
}
