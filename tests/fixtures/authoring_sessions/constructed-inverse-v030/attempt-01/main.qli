use std::quantum::{h,z,init0};
use std::observe::measure_z;
unitary fn oracle(q:Q<Bit>)->Q<Bit>{h(z(q))}
unitary fn inverse_twice(q:Q<Bit>)->Q<Bit>{inverse(power(oracle,2))(q)}
observe fn main()->Bit{measure_z(inverse_twice(init0()))}
