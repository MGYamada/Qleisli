use std::state::init0;
unitary fn strip(q:Q<(Unit,Bit)>)->Q<Bit>{let(u,b)=split(q);finish(u);b}
fn invoke[const U:Op<(Unit,Bit)>](q:Q<(Unit,Bit)>)->Q<(Unit,Bit)> requires Applicable(U){U(q)}
pub unitary fn main(q:Q<(Unit,Bit)>)->Q<(Unit,Bit)>{invoke[strip](q)}
