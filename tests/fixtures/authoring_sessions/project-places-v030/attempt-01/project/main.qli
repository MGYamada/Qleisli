#![no_implicit_prelude]
use std::state::init0;
use std::gate::cnot;
pub unitary fn couple(q: Q<Bits<2>>) -> Q<Bits<2>> {
    cnot(ctrl q[0], excl q[1]);
    q
}
pub observe fn main() -> (Bit, Bit) {
    let q = put_bit[2,0](h(init0()), put_bit[1,0](init0(), basis unit(()) as _ { empty_bits() }));
    let (a,r) = take_bit[2,0](couple(q));
    let (b,empty) = take_bit[1,0](r);
    discard(empty);
    (measure_z(a), measure_z(b))
}
