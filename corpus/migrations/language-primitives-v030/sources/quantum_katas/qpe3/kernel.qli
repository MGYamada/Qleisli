use std::gate::s;


use std::gate::t;


use std::transform::qft3;
unitary fn power0(q: Q<Bit>) -> Q<Bit> { power(migration_t, 1)(q) }
unitary fn power1(q: Q<Bit>) -> Q<Bit> { s(q) }
unitary fn power2(q: Q<Bit>) -> Q<Bit> { power(migration_t, 4)(q) }

pub unitary fn kernel(q: Q<(((Bit, Bit), Bit), Bit)>) -> Q<(((Bit, Bit), Bit), Bit)> {
    let (part3, d) = split(q);
    let (part2, c) = split(part3);
    let (a, b) = split(part2);
    let (a, d) = qif(h(a), d) { 0 => id, 1 => power0 };
    let (b, d) = qif(h(b), d) { 0 => id, 1 => power1 };
    let (c, d) = qif(h(c), d) { 0 => id, 1 => power2 };
    join(adjoint(qft3)(join(join(a, b), c)), d)
}

unitary fn migration_t(q: Q<Bit>) -> Q<Bit> { t(q) }

/// Identity on the one-Bit target of a coherent branch.
unitary fn id(q: Q<Bit>) -> Q<Bit> { q }
