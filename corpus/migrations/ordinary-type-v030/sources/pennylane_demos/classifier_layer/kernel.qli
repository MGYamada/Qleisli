// Selected symbol(s): layer (four-wire version)
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::h;
use std::quantum::z;
use std::quantum::cnot;
use std::quantum::join;
use std::quantum::split;

pub unitary fn kernel(q: Q<(((Bit, Bit), Bit), Bit)>) -> Q<(((Bit, Bit), Bit), Bit)> {
    let (part3, d) = split(q);
    let (part2, c) = split(part3);
    let (a, b) = split(part2);
    let a = h(z(a));
    let b = h(z(b));
    let c = h(z(c));
    let d = h(z(d));
    let (a, b) = cnot(a, b);
    let (b, c) = cnot(b, c);
    let (c, d) = cnot(c, d);
    let (d, a) = cnot(d, a);
    join(join(join(a, b), c), d)
}
