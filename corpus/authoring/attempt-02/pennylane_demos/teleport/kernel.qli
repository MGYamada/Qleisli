// Selected symbol(s): teleport; measure_and_update
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::init0;
use std::quantum::h;
use std::quantum::x;
use std::quantum::z;
use std::quantum::t;
use std::quantum::cnot;
use std::quantum::toffoli;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;

pub observe fn teleport(q: Q<Bit>) -> ((CBit, CBit), Q<Bit>) {
    let (alice, bob) = cnot(h(init0()), init0());
    let (q, alice) = cnot(q, alice);
    let phase = measure_z(h(q));
    let parity = measure_z(alice);
    let bob = if parity { x(bob) } else { bob };
    let bob = if phase { z(bob) } else { bob };
    ((phase, parity), bob)
}
