// Selected symbol: U_C

use std::gate::x;
use std::gate::z;
use std::gate::s;
use std::gate::t;
use std::gate::tdg;


use std::gate::toffoli;
use std::gate::cnot;



unitary fn rz(q: Q<Bit>) -> Q<Bit> { adjoint(global_phase_eighth)(s(q)) }
pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, d) = split(q);
    let (a, b) = split(ab);
    let (a, b) = cnot(a, b);
    let (a, b) = cnot(a, rz(b));
    let (b, d) = cnot(b, d);
    let (b, d) = cnot(b, rz(d));
    join(join(a, b), d)
}
