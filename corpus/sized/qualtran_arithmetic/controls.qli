use controls::all_ones;
use std::quantum::x;
use std::registers::take_bit;
use std::registers::put_bit;

/// Flip target iff every control is one. The empty conjunction is true.
/// Recurse through coherent controls, without measuring or copying any owner.
pub unitary fn all_ones[static n: Nat](controls: Q<Bits<n>>, target: Q<Bit>)
    -> (Q<Bits<n>>, Q<Bit>) {
    if static n == 0 {
        (controls,x(target))
    } else {
        let (head,rest) = take_bit[n,0](controls);
        let (head,(rest,target)) = controlled(all_ones[n-1])(head,(rest,target));
        (put_bit[n,0](head,rest),target)
    }
}
