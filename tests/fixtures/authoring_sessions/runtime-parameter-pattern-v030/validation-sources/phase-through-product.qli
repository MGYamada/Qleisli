use std::quantum::{phase_eighth,init0,split,h};
use std::observe::{discard,measure_z};
unitary fn through(((),q): (Unit,Q<Unit>)) -> Q<Unit> { phase_eighth(q) }
unitary fn phase(q: Q<Unit>) -> Q<Unit> { through(((),q)) }
unitary fn identity(q: Q<Unit>) -> Q<Unit> { q }
observe fn main() -> Bit {
 let pair = do bit <- init0(); pure ((),bit);
 let (unit,bit) = split(pair);
 let (control,unit) = qif(h(init0()),unit) { 0 => identity, 1 => phase };
 discard(unit); discard(bit); measure_z(h(control))
}
