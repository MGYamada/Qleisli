// Selected symbol(s): layer (four-wire version)
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::init0;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;
use kernel::kernel;

observe fn main() -> (((CBit, CBit), CBit), CBit) {
    let q = kernel(join(join(join(init0(), init0()), init0()), init0()));
    let (part3, d) = split(q);
    let (part2, c) = split(part3);
    let (a, b) = split(part2);
    (((measure_z(a), measure_z(b)), measure_z(c)), measure_z(d))
}
