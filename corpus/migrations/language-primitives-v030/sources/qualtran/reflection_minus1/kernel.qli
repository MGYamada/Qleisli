use std::gate::z;

classical fn zero(a: Bit) -> Bit { not a }



pub unitary fn kernel(q: Q<Bit>) -> Q<Bit> {
    let q = h(q);
    let q = with_computed(q, zero) { |flag| z(flag) };
    let q = h(q);
    power(migration_scalar_eighth, 4)(q)
}

unitary fn migration_scalar_eighth(q: Q<Bit>) -> Q<Bit> { global_phase_eighth(q) }
