// Selected symbol(s): quantum_lock; quantum_locking_mechanism
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::init0;
use std::quantum::h;
use std::quantum::x;
use std::quantum::z;
use std::quantum::t;
use std::quantum::cnot;
use std::quantum::toffoli;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;
basis fn lock(control: Bit, a: Bit, b: Bit, c: Bit, d: Bit) -> Bit {
    control and not a and b and c and d
}
pub unitary fn kernel(q: Q<(Bit, Bit, Bit, Bit, Bit)>) -> Q<(Bit, Bit, Bit, Bit, Bit)> {
    let (part4, e) = split(q);
    let (part3, d) = split(part4);
    let (part2, c) = split(part3);
    let (a, b) = split(part2);
    let q = join(join(join(join(h(a), b), c), d), e);
    let q = with_computed(q, lock) { |flag| z(flag) };
    let (part4, e) = split(q);
    let (part3, d) = split(part4);
    let (part2, c) = split(part3);
    let (a, b) = split(part2);
    join(join(join(join(h(a), b), c), d), e)
}
