use std::quantum::{unit,finish,split,join};
unitary fn remove(q:Q<(Unit,Bit)>)->Q<Bit>{let(u,a)=split(q);let()=finish(u);a}
unitary fn add(a:Q<Bit>)->Q<(Unit,Bit)>{join(unit(()),a)}
pub unitary fn f(q:Q<(Unit,Bit)>)->Q<(Unit,Bit)>{add(remove(q))}
pub unitary fn g(a:Q<Bits<0>>)->Q<Bits<0>>{let(q,u)=split(join(a,unit(())));let()=finish(u);q}

observe fn main()->Unit{()}
