use std::quantum::{unit,finish,phase_eighth};
use std::observe::measure_z;
use std::classical::{empty_bits,prepend_bit};
pub observe fn f(q: Q<Bit>) -> Bits<1> { let b = measure_z(q); let u = unit(()); let () = finish(u); prepend_bit[0](b,empty_bits()) }
