use std::quantum::phase_eighth;
classical fn angle0(q:Bits<0>)->(Bit,(Bit,Bit)){(1,(0,0))}
classical fn angle1(q:Bits<1>)->(Bit,(Bit,Bit)){(1,(0,0))}
meaning Scalar0:Bits<0> = phase_by(angle0);
meaning Scalar1:Bits<1> = phase_by(angle1);
unitary fn leaf0(q:Q<Bits<0>>)->Q<Bits<0>>{phase_eighth(q)}
unitary fn leaf1(q:Q<Bits<1>>)->Q<Bits<1>>{phase_eighth(q)}
unitary fn run[const A:Basis,const n:Nat,const U:Op<A>](q:Q<A>)->Q<A>
requires Apply(U),n<=2{qfor static i in 0..n carry a=q{yield U(a)}}
pub unitary fn zero(q:Q<Bits<0>>)->Q<Bits<0>>{
    run[type(Bits<0>),1,checked_op(leaf0,Scalar0)](q)
}
pub unitary fn one(q:Q<Bits<1>>)->Q<Bits<1>>{
    run[type(Bits<1>),2,checked_op(leaf1,Scalar1)](q)
}
