use std::gate::cnot;




pub observe fn bell_measure(q: Q<(Bit, Bit)>) -> (Bit, Bit) {
    let (a, b) = split(q);
    let (a, b) = cnot(a, b);
    (measure_z(h(a)), measure_z(b))
}
