use std::quantum::{unit,finish,split,join,phase_eighth};
pub unitary fn remove(q:Q<(Unit,Unit)>)->Q<Unit>{let(u,a)=split(q);let()=finish(u);a}
pub unitary fn insert(a:Q<Unit>)->Q<(Unit,Unit)>{join(unit(()),a)}
pub unitary fn round(q:Q<(Unit,Unit)>)->Q<(Unit,Unit)>{let(u,a)=split(q);let()=finish(u);join(unit(()),a)}
pub unitary fn phase_remove(q:Q<(Unit,Unit)>)->Q<Unit>{let(u,a)=split(q);let()=finish(phase_eighth(u));a}
