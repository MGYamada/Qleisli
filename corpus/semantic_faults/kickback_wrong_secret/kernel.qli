// Selected symbol(s): quantum_lock; quantum_locking_mechanism
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::h;
use std::quantum::z;
use std::quantum::x;
use std::quantum::join;
use std::quantum::split;

unitary fn identity(q: Q<Bit>) -> Q<Bit> { q }
unitary fn lock(q: Q<Bit>) -> Q<Bit> { x(z(x(q))) }
pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (meter, key) = split(q);
    let (meter, key) = qif(h(meter), key) { 0 => identity, 1 => lock };
    join(h(meter), key)
}
