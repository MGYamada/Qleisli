pub unitary fn remove(q:Q<(Unit,Unit)>)->Q<Unit>{let(a,u)=split(q);let()=finish(u);a}
pub unitary fn insert(a:Q<Unit>)->Q<(Unit,Unit)>{join(a,unit(()))}
pub unitary fn round(q:Q<(Unit,Unit)>)->Q<(Unit,Unit)>{let(a,u)=split(q);let()=finish(u);join(a,unit(()))}
pub unitary fn phase_remove(q:Q<(Unit,Unit)>)->Q<Unit>{let(a,u)=split(q);let()=finish(global_phase_eighth(u));a}
