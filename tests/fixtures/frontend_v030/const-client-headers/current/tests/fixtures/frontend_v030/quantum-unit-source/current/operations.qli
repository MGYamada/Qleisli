use std::quantum::phase_eighth;
pub unitary fn scalar(q: Q<Unit>) -> Q<Unit> { phase_eighth(q) }
pub unitary fn apply[const U: Op<Unit>](q: Q<Unit>) -> Q<Unit> requires Apply(U) { U(q) }
pub unitary fn inverse[const U: Op<Unit>](q: Q<Unit>) -> Q<Unit> requires Adjoint(U) { adjoint(U,q) }
pub unitary fn eight[const U: Op<Unit>](q: Q<Unit>) -> Q<Unit> requires Apply(U) { apply[repeat_op(8,U)](q) }
pub unitary fn controlled_once[const U: Op<Unit>](c: Q<Bit>,q: Q<Unit>) -> (Q<Bit>,Q<Unit>) requires Controlled(U) { controlled(U)(c,q) }
pub unitary fn controlled_four[const U: Op<Unit>](c: Q<Bit>,q: Q<Unit>) -> (Q<Bit>,Q<Unit>) requires Controlled(U) { controlled(repeat_op(4,U))(c,q) }
