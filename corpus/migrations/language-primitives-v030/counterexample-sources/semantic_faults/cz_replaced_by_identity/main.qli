use std::state::init0;

use std::gate::x;
use std::gate::t;
use std::gate::cnot;



use kernel::kernel;
observe fn main() -> (Bit, Bit) {
let q = join(init0(), init0());
let q = kernel(q);
let (w0, w1) = split(q);
(measure_z(w0), measure_z(w1))
}
