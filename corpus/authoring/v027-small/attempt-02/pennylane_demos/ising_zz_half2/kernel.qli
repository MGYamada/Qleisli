// Selected symbol: U_C(gamma), single-edge factor; gamma=pi
use std::quantum::z;
use std::quantum::phase_eighth;
use std::quantum::split;
use std::quantum::join;

pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    let a = adjoint(phase_eighth, adjoint(phase_eighth, z(a)));
    join(a, z(b))
}
