// Deliberate QLI rejection fixture; not an external translation.
use std::quantum::init0;
use std::quantum::x;
use std::observe::measure_z;
classical fn identity(a: Bit) -> Bit { a }
observe fn main() -> Bit {
    let q = with_computed(init0(),identity) { |flag| x(flag) };
    measure_z(q)
}
