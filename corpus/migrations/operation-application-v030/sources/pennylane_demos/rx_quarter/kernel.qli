use std::quantum::h;
use std::quantum::t;

classical fn one(a: Bit) -> Bit { 1 }
// RZ(pi/2) has scalar exp(-i*pi/4), which must survive coherent control.
unitary fn scalar(q: Q<Bit>) -> Q<Bit> {
    with_computed(q, one) { |flag| t(t(t(t(t(t(t(flag))))))) }
}
unitary fn rz_quarter(q: Q<Bit>) -> Q<Bit> { scalar(power(migration_t, 2)(q)) }
pub unitary fn kernel(q: Q<Bit>) -> Q<Bit> { h(rz_quarter(h(q))) }

unitary fn migration_t(q: Q<Bit>) -> Q<Bit> { t(q) }
