// Selected symbol(s): circuit(params)
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

// Deliberate type-correct semantic mutation: Exchange RX and RY: the operators do not commute and their complex interference differs even where Z probabilities agree.

use std::quantum::h;
use std::quantum::s;
use std::quantum::z;
use std::quantum::phase_eighth;

unitary fn rx(q: Q<Bit>) -> Q<Bit> { adjoint(phase_eighth, h(s(h(q)))) }
pub unitary fn kernel(q: Q<Bit>) -> Q<Bit> { rx(z(h(q))) }
