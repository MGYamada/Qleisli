use std::quantum::{init0,x};
use std::observe::measure_z;
fn wrapped_x(q: Q<Bit>) -> Q<Bit> { x(q) }
unitary fn apply_gate[static U: Op<Bit>](q: Q<Bit>) -> Q<Bit>
requires Apply(U) { U(q) }
pub observe fn main() -> (Bit,Bit) {
    let a = apply_gate[then_op(wrapped_x,wrapped_x)](init0());
    let b = apply_gate[then_op(wrapped_x,wrapped_x)](init0());
    (measure_z(a),measure_z(b))
}
