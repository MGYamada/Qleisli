use std::state::init0; use std::gate::x; 
         unitary fn apply[const U:Op<Bit>](q:Q<Bit>)->Q<Bit> requires Applicable(U){U(q)}
         unitary fn specified(q:Q<Bit>)->Q<Bit>{x(q)}
unitary fn p0(q:Q<Bit>)->Q<Bit>{x(q)}
unitary fn p1(q:Q<Bit>)->Q<Bit>{x(q)}
unitary fn p2(q:Q<Bit>)->Q<Bit>{x(q)}
unitary fn p3(q:Q<Bit>)->Q<Bit>{x(q)}
observe fn main()->Bit{let q=init0();
let q=apply[p0](q);
let q=apply[p1](q);
let q=apply[p2](q);
let q=apply[p3](q);
measure_z(q)}
