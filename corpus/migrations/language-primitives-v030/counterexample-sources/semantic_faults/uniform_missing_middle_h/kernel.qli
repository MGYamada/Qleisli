use std::gate::x;
use std::gate::z;
use std::gate::s;
use std::gate::t;
use std::gate::tdg;


use std::gate::toffoli;
use std::gate::cnot;



pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, d) = split(q);
    let (a, b) = split(ab);
    join(join(h(a), b), h(d))
}
