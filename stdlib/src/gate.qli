//! Ordinary phase-fixed gate definitions for edition 2026.
//!
//! Every body uses the same source and native checks as user code. No function
//! here is a sealed gate intrinsic or a structural axis-routing helper.
//! Copyright 2026 Qleisli Project Contributors. SPDX-License-Identifier: Apache-2.0.
use std::quantum::h;
use std::quantum::phase_eighth;
use std::quantum::phase;
use std::quantum::unit;
use std::quantum::finish;
use std::quantum::split;
use std::quantum::join;

/// Identity preserves the exact Basis tree, including zero-width owners.
pub unitary fn id[const A: Basis](q: Q<A>) -> Q<A> { q }

/// Exact scalar zeta_8 I on one logical Unit owner, including its phase.
unitary fn scalar_eighth(u: Q<Unit>) -> Q<Unit> {
    phase_eighth(u)
}

/// T = diag(1,zeta_8), with exact phase for every input and external reference.
/// Coherent control exposes the scalar as relative phase. The Unit target has
/// no physical wire, but remains owned until finish; realized T cost is separate.
pub unitary fn t(q: Q<Bit>) -> Q<Bit> {
    let (q,u) = controlled(scalar_eighth)(q,unit(()));
    finish(u);
    q
}

/// Exact diag(1,i), derived as two T actions.
pub unitary fn s(q: Q<Bit>) -> Q<Bit> { power(t,2)(q) }

/// Exact diag(1,-i), retaining the full phase of six T actions.
pub unitary fn sdg(q: Q<Bit>) -> Q<Bit> { power(t,6)(q) }

/// Exact T inverse diag(1,zeta_8^-1), derived as seven T actions.
pub unitary fn tdg(q: Q<Bit>) -> Q<Bit> { power(t,7)(q) }

/// Exact Z = diag(1,-1), derived as four T actions.
pub unitary fn z(q: Q<Bit>) -> Q<Bit> { power(t,4)(q) }

/// Exact bit flip H Z H, with coefficient +1 on both basis transitions.
pub unitary fn x(q: Q<Bit>) -> Q<Bit> { h(z(h(q))) }

unitary fn phase_leaf[const j: Nat, const k: Nat](q: Q<Bit>) -> Q<Bit> {
    phase[j,k](q)
}

/// Exact diag(1,1,1,exp(2*pi*i*j/2^k)) in control/target axis order.
/// The phase provider retains its own concrete coefficient/profile conditions.
/// Both owners return; no measurement, workspace or implicit phase quotient.
pub unitary fn controlled_phase[const j: Nat, const k: Nat](a: Q<Bit>, b: Q<Bit>) -> (Q<Bit>, Q<Bit>) {
    controlled(phase_leaf[j,k])(a,b)
}

/// Exact controlled bit flip, derived from the ordinary X provider.
pub unitary fn cnot(a: Q<Bit>, b: Q<Bit>) -> (Q<Bit>, Q<Bit>) {
    controlled(x)(a,b)
}

unitary fn cnot_pair(q: Q<(Bit,Bit)>) -> Q<(Bit,Bit)> {
    let (a,b) = split(q);
    let (a,b) = cnot(a,b);
    join(a,b)
}

/// Two controls retain their basis values and the target flips iff both are one.
pub unitary fn toffoli(a: Q<Bit>, b: Q<Bit>, c: Q<Bit>) -> ((Q<Bit>,Q<Bit>),Q<Bit>) {
    let (a,q) = controlled(cnot_pair)(a,join(b,c));
    let (b,c) = split(q);
    ((a,b),c)
}

/// Physical SWAP: |a,b> -> |b,a>, with exact coefficient +1, for all inputs
/// and external references. The returned owners keep their original wire order.
/// Three ordinary CNOT calls retain their controlled-X work. Target gate costs
/// depend on a checked realization; no physical workspace is allocated here.
pub unitary fn swap(a: Q<Bit>, b: Q<Bit>) -> (Q<Bit>, Q<Bit>) {
    let (a,b) = cnot(a,b);
    let (b,a) = cnot(b,a);
    cnot(a,b)
}
