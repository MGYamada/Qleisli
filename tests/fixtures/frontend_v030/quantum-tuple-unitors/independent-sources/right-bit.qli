use std::quantum::{unit,finish,split,join,phase_eighth};
pub unitary fn remove(q:Q<(Bit,Unit)>)->Q<Bit>{let(a,u)=split(q);let()=finish(u);a}
pub unitary fn insert(a:Q<Bit>)->Q<(Bit,Unit)>{join(a,unit(()))}
pub unitary fn round(q:Q<(Bit,Unit)>)->Q<(Bit,Unit)>{let(a,u)=split(q);let()=finish(u);join(a,unit(()))}
pub unitary fn phase_remove(q:Q<(Bit,Unit)>)->Q<Bit>{let(a,u)=split(q);let()=finish(phase_eighth(u));a}
