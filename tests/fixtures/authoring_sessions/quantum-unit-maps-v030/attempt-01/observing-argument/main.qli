use std::quantum::unit;
use std::quantum::finish;
use std::observe::measure_z;
observe fn consume(q: Q<Bit>) -> Unit { let _ = measure_z(q); () }
pub observe fn f(q: Q<Bit>) -> Unit { finish(unit(consume(q))) }

observe fn main() -> Unit { () }
