// Selected symbol: U_C
use std::quantum::h;
use std::quantum::x;
use std::quantum::z;
use std::quantum::s;
use std::quantum::t;
use std::quantum::tdg;
use std::quantum::id;
use std::quantum::phase_eighth;
use std::quantum::toffoli;
use std::quantum::cnot;
use std::quantum::join;
use std::quantum::split;

unitary fn rz(q: Q<Bit>) -> Q<Bit> { adjoint(phase_eighth, s(q)) }
pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, d) = split(q);
    let (a, b) = split(ab);
    let (a, b) = cnot(a, b);
    let (a, b) = cnot(a, rz(b));
    let (b, d) = cnot(b, d);
    let (b, d) = cnot(b, d);
    join(join(a, b), d)
}
