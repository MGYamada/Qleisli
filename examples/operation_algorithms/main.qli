//! Estimate T's phase on |1>: output 1001, with low-weight phase bits first.
use gates::eighth_phase;
use estimation::phase3;
use std::state::init0;
use std::gate::x;


observe fn main() -> ((Bit,Bit,Bit),Bit) {
    let (phase_word,target) = phase3[eighth_phase](x(init0()));
    (phase_word,measure_z(target))
}
