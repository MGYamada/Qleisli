          "cargo",
          "+1.98.1",
          "clippy",
          "--all-targets",
          "--",
          "-D",
          "warnings"
        ],
        [
          "cargo",
          "+1.98.1",
          "fmt",
          "--manifest-path",
          "research/semantic-kernel/Cargo.toml",
          "--check"
        ],
        [
          "cargo",
          "+1.98.1",
          "test",
          "--manifest-path",
          "research/semantic-kernel/Cargo.toml",
          "--all-targets"
