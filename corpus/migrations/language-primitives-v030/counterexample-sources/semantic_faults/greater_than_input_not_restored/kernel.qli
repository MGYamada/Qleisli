// Modified from https://github.com/quantumlib/Qualtran/blob/8db02b8b3fb39d69d2900dcc7b52d9d6a36834c3/qualtran/bloqs/arithmetic/comparison.py
// Selected symbol(s): GreaterThan
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

// Deliberate type-correct semantic mutation: Leave b complemented after computing the correct predicate: the target agrees but the retained input contract fails.

use std::gate::x;
use std::gate::toffoli;



pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, target) = split(q);
    let (a, b) = split(ab);
    let ((a, b), target) = toffoli(a, x(b), target);
    join(join(a, b), target)
}
