use oracle::mark;
use std::quantum::init0;
use std::quantum::join;
use std::transform::hadamard2;
use std::reflection::reflect_uniform2;

pub unitary fn step(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    reflect_uniform2(mark(q))
}

// N = 4, one marked input: exactly one amplification step.
pub isometry fn search_one() -> Q<(Bit, Bit)> {
    let prepared = hadamard2(join(init0(), init0()));
    step(prepared)
}
