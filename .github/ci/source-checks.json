    "rust-latest-lint-research": {
      "lanes": [
        "check-rust"
      ],
      "tools": [
        "python",
        "rust-latest",
        "cargo-latest",
        "lean",
        "git"
      ],
      "prerequisites": [
        "Build lean-kernel and run its Audit.lean before Rust tests; select that checker with QLEISLI_KERNEL."
      ],
      "environment": {
        "RUSTUP_TOOLCHAIN": "1.98.1",
        "ELAN_TOOLCHAIN": "leanprover/lean4:v4.30.0",
        "RUSTDOCFLAGS": "-D warnings"
      },
      "timeout_seconds": 3600,
