use std::quantum::unit;
use std::quantum::finish;
pub unitary fn left(q: Q<Bit>) -> (Q<Unit>, Q<Bit>) { (unit(()),q) }
pub unitary fn remove((u,q): (Q<Unit>, Q<Bit>)) -> Q<Bit> { let () = finish(u); q }
pub unitary fn f(q: Q<Bit>) -> Q<Bit> { remove(left(q)) }

observe fn main() -> Unit { () }
