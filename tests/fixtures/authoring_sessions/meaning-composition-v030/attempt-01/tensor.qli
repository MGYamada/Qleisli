use std::quantum::{h,init0,x,z,join,split};
use std::observe::measure_z;
classical fn flip(b:Bit)->Bit{not b}
classical fn phase(b:Bit)->(Bit,(Bit,Bit)){(0,(0,b))}
meaning X:Bit=permutation_by(flip);
meaning Z:Bit=phase_by(phase);
meaning M:(Bit,Bit)=tensor(Z,X);
unitary fn implementation(q:Q<(Bit,Bit)>)->Q<(Bit,Bit)>{let(a,b)=split(q);join(z(a),x(b))}
fn invoke[const U:Op<(Bit,Bit),M>](q:Q<(Bit,Bit)>)->Q<(Bit,Bit)> requires Applicable(U){U(q)}
observe fn main()->(Bit,Bit){let(a,b)=split(invoke[checked_op(implementation,M)](join(h(init0()),init0())));(measure_z(a),measure_z(b))}
