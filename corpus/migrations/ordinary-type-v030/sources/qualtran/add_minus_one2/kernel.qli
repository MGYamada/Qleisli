use std::quantum::x;
use std::quantum::cnot;
use std::quantum::join;
use std::quantum::split;

pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    // Flip the low bit before using it to propagate the borrow.
    let (a, b) = cnot(x(a), b);
    join(a, b)
}
