use std::quantum::init0;
use std::quantum::h;
use std::quantum::x;
use std::quantum::z;
use std::quantum::t;
use std::quantum::cnot;
use std::quantum::toffoli;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;

pub observe fn send(phase: CBit, parity: CBit) -> (CBit, CBit) {
    let (a, b) = cnot(h(init0()), init0());
    let a = if phase { z(a) } else { a };
    let a = if parity { x(a) } else { a };
    let (a, b) = cnot(a, b);
    (measure_z(h(a)), measure_z(b))
}
