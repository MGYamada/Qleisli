// Desired sized translation of the retained Qualtran Xor decomposition.
// Source pin: 8db02b8b3fb39d69d2900dcc7b52d9d6a36834c3, qualtran/bloqs/arithmetic/bitwise.py.
// Draft notation; no supported source API is asserted by this snapshot.
use std::quantum::cnot;
use std::registers::take_bit;
use std::registers::put_bit;

/// |x,y> -> |x,y xor x>, with phase +1 on every input and reference.
/// An empty fold at n=0 still consumes and returns two distinct owners.
pub unitary fn xor[static n: Nat](x: Q<Bits<n>>, y: Q<Bits<n>>)
    -> (Q<Bits<n>>, Q<Bits<n>>) {
    for static k in 0..n carry pair = (x,y) {
        let (x,y) = pair;
        let (a,x) = take_bit[n,k](x);
        let (b,y) = take_bit[n,k](y);
        let (a,b) = cnot(a,b);
        yield (put_bit[n,k](a,x),put_bit[n,k](b,y));
    }
}
