use std::gate::x;
classical fn flip(b:Bit)->Bit{not b}
meaning Flip:Bit=permutation_by(flip);
pub unitary fn implementation(q:Q<Bit>)->Q<Bit>{x(q)}
unitary fn inner[const U:Op<Bit>](q:Q<Bit>)->Q<Bit> requires Applicable(U){q}
pub unitary fn outer[const k:Nat,const U:Op<Bit>](q:Q<Bit>)->Q<Bit> requires Applicable(U),k<=2 {inner[power(U,k)](q)}