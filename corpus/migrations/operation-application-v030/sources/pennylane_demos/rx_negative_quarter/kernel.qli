use std::quantum::s;
use std::quantum::phase_eighth;
use std::quantum::h;
use std::quantum::t;

unitary fn rz_quarter(q: Q<Bit>) -> Q<Bit> { inverse(phase_eighth)(s(q)) }
pub unitary fn kernel(q: Q<Bit>) -> Q<Bit> { h(inverse(rz_quarter)(h(q))) }
