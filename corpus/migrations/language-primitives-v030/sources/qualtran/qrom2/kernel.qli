// Selected symbol(s): QROM
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::gate::x;
use std::gate::cnot;



pub unitary fn kernel(q: Q<(((Bit, Bit), Bit), Bit)>) -> Q<(((Bit, Bit), Bit), Bit)> {
    let (part3, d) = split(q);
    let (part2, c) = split(part3);
    let (a, b) = split(part2);
    let (a, c) = cnot(a, c);
    let c = x(c);
    let (a, d) = cnot(a, d);
    let (b, d) = cnot(b, d);
    join(join(join(a, b), c), d)
}
