// Modified from pinned Qualtran TextbookQPE; see README.md.
use preparation::hadamard_bits;
use fourier::fourier;
use std::registers::take_bit;
use std::registers::put_bit;

/// Coherent QPE: arbitrary phase and target inputs; no measurement or zero premise.
/// With phase initially zero this yields sum_y |y> K_y(U)|target>.
pub unitary fn estimate[static n: Nat, static m: Nat, static U: Op<Bits<n>>](
    phase: Q<Bits<m>>, target: Q<Bits<n>>
) -> (Q<Bits<m>>, Q<Bits<n>>)
requires n >= 1, m >= 1, Controlled(U) {
    let phase = hadamard_bits[m](phase);
    let (phase,target) = qfor static k in 0..m carry pair = (phase,target) {
        let (phase,target) = pair;
        let (control,rest) = take_bit[m,k](phase);
        let (control,target) = controlled(repeat_op(2^k,U))(control,target);
        yield (put_bit[m,k](control,rest),target);
    };
    (adjoint(fourier[m],phase),target)
}
