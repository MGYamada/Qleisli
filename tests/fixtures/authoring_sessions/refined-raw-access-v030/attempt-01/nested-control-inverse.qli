use std::quantum::phase;
fn twist(q:Q<Bit>)->Q<Bit>{phase[1,3](q)}
classical fn phi(b:Bit)->(Bit,(Bit,Bit)){(b,(0,0))}
meaning M:Bit=phase_by(phi);
fn invoke[const U:Op<(Bit,Bit)>](q:Q<(Bit,Bit)>)->Q<(Bit,Bit)> requires Applicable(U){U(q)}
pub fn main(q:Q<(Bit,Bit)>)->Q<(Bit,Bit)>{invoke[adjoint(controlled(checked_op(twist,M)))](q)}
