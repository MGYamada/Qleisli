use std::state::init0;

unitary fn eighth(q: Q<Bit>) -> Q<Bit> { phase[1,3](q) }
unitary fn apply[const U: Op<Bit>](q: Q<Bit>) -> Q<Bit> requires Applicable(U) { U(q) }

unitary fn logical(q: Q<Bit>) -> Q<Bit> { phase[3,2](q) }

pub observe fn main() -> Bit {
    let q = clean(init0(), logical) { |data, scratch| (apply[power(adjoint(eighth),2)](data), scratch) };
    measure_z(q)
}
