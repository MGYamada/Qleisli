use bitwise::xor_into;
use controls::all_ones;
use std::quantum::x;
use std::registers::take_bit;
use std::registers::put_bit;

/// |x,y,t> -> |x,y,t xor [x=y]> with phase +1 on the entire space.
/// Compute differences into y, compare coherently, then restore y exactly.
pub unitary fn equals[static n: Nat](left: Q<Bits<n>>, y: Q<Bits<n>>, target: Q<Bit>)
    -> (Q<Bits<n>>, Q<Bits<n>>, Q<Bit>) {
    let (left,y) = xor_into[n](left,y);
    let y = for static k in 0..n carry register = y {
        let (bit,rest) = take_bit[n,k](register);
        yield put_bit[n,k](x(bit),rest);
    };
    let (y,target) = all_ones[n](y,target);
    let y = for static k in 0..n carry register = y {
        let (bit,rest) = take_bit[n,k](register);
        yield put_bit[n,k](x(bit),rest);
    };
    let (left,y) = xor_into[n](left,y);
    (left,y,target)
}
