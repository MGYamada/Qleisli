// Selected symbol(s): TextbookQPE
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::init0;
use std::quantum::h;
use std::quantum::x;
use std::quantum::z;
use std::quantum::t;
use std::quantum::cnot;
use std::quantum::toffoli;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;
use std::transforms::qft2;
unitary fn identity(q: Q<Bit>) -> Q<Bit> { q }
unitary fn power0(q: Q<Bit>) -> Q<Bit> { repeat_static(2, t, q) }
unitary fn power1(q: Q<Bit>) -> Q<Bit> { repeat_static(4, t, q) }

pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (part2, c) = split(q);
    let (a, b) = split(part2);
    let (a, c) = qif(h(a), c) { 0 => identity, 1 => power0 };
    let (b, c) = qif(h(b), c) { 0 => identity, 1 => power1 };
    join(adjoint(qft2, join(a, b)), c)
}
