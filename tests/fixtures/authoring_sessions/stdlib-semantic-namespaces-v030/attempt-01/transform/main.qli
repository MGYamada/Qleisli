//! Informed desired namespace client; unexecuted before-source snapshot.
//! A check outcome is separate from the mathematical contract and proof.
use std::transform::hadamard2;
use std::quantum::init0;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;

/// Consume both prepared owners after the exact ordered H tensor H transform.
/// This closed discovery client does not check its complex operator or phase.
fn main() -> (Bit, Bit) {
    let q = hadamard2(join(init0(), init0()));
    let (a, b) = split(q);
    (measure_z(a), measure_z(b))
}
