// Selected symbol(s): LessThanEqual
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

// Deliberate type-correct semantic mutation: Omit equality by computing a<b: equal operands must toggle the target in the intended inclusive comparison.

use std::quantum::x;
use std::quantum::toffoli;
use std::quantum::join;
use std::quantum::split;

pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, target) = split(q);
    let (a, b) = split(ab);
    let ((a, b), target) = toffoli(x(a), b, target);
    join(join(x(a), b), target)
}
