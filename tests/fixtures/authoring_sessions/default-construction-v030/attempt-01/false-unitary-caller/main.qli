use std::quantum::init0;
use std::observe::measure_z;

iso fn default() -> Q<Bit> { init0() }

// The deliberate false assertion must not hide the callee's Iso action.
unitary fn pretend_unitary() -> Q<Bit> { default() }

observe fn main() -> Bit { measure_z(pretend_unitary()) }
