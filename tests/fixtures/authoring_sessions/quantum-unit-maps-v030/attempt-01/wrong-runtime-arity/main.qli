use std::quantum::unit;
use std::quantum::finish;
pub unitary fn f() -> Q<Unit> { unit() }
pub unitary fn unit_two() -> Q<Unit> { unit((),()) }
pub unitary fn finish_zero() -> Unit { finish() }
pub unitary fn finish_two(q: Q<Unit>,r: Q<Unit>) -> Unit { finish(q,r) }

observe fn main() -> Unit { () }
