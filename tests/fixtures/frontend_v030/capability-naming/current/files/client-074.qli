use std::quantum::{unit,finish,split,join,phase_eighth};
pub unitary fn scalar(q:Q<(Unit,Bit)>)->Q<(Unit,Bit)>{let(u,a)=split(q);let()=finish(phase_eighth(u));join(unit(()),a)}
pub unitary fn apply[const U:Op<(Unit,Bit)>](q:Q<(Unit,Bit)>)->Q<(Unit,Bit)> requires Applicable(U){U(q)}
pub unitary fn inverse[const U:Op<(Unit,Bit)>](q:Q<(Unit,Bit)>)->Q<(Unit,Bit)> requires Adjointable(U){adjoint(U)(q)}
pub unitary fn eight[const U:Op<(Unit,Bit)>](q:Q<(Unit,Bit)>)->Q<(Unit,Bit)> requires Applicable(U){apply[power(U,8)](q)}
pub unitary fn controlled_four[const U:Op<(Unit,Bit)>](c:Q<Bit>,q:Q<(Unit,Bit)>)->(Q<Bit>,Q<(Unit,Bit)>) requires Controllable(U){controlled(power(U,4))(c,q)}
