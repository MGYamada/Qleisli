use std::quantum::x;
classical fn flip(b:Bit)->Bit{not b}
meaning Flip:Bit=permutation_by(flip);
unitary fn leaf(q:Q<Bit>)->Q<Bit>{x(q)}
unitary fn helper[static U:Op<Bit>](q:Q<Bit>)->Q<Bit> requires Apply(U){U(q)}
pub unitary fn implementation(q:Q<Bit>)->Q<Bit>{helper[leaf](q)}
unitary fn use_op[static U:Op<Bit>](q:Q<Bit>)->Q<Bit> requires Apply(U){U(q)}
pub unitary fn client(q:Q<Bit>)->Q<Bit>{use_op[checked_op(implementation,Flip)](q)}
