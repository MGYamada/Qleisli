    "rust-latest": {
      "lanes": [
        "check-rust"
      ],
      "tools": [
        "python",
        "rust-latest",
        "cargo-latest",
        "lean",
        "git"
      ],
      "prerequisites": [
        "Install the listed toolchains; native preparation runs before Rust tests."
      ],
      "environment": {
        "RUSTUP_TOOLCHAIN": "1.98.1",
        "ELAN_TOOLCHAIN": "leanprover/lean4:v4.30.0",
        "RUSTDOCFLAGS": "-D warnings"
      },
      "timeout_seconds": 3600,
      "commands": [
        [
          "cargo",
          "+1.98.1",
          "fmt",
          "--check"
        ],
        [
          "cargo",
          "+1.98.1",
          "test",
          "--all-targets"
        ],
        [
          "cargo",
          "+1.98.1",
          "test",
          "--test",
          "sized_review_dialects",
          "--",
          "--ignored",
          "--skip",
