use std::quantum::init0;
use std::quantum::h;
use std::quantum::cnot;
use std::quantum::split;
use std::observe::measure_z;
use std::quantum::t;
use std::quantum::tdg;
pub iso fn entangle(q: Q<Bit>) -> Q<(Bit,Bit)> { basis q as x { (x,x) } }
observe fn main() -> (Bit,Bit,Bit) {
    let (a,r)=cnot(h(init0()),init0());
    let (a,b)=split(entangle(t(a)));
    let (a,b)=cnot(a,b);
    let (a,r)=cnot(a,r);
    (measure_z(h(tdg(a))),measure_z(b),measure_z(r))
}
