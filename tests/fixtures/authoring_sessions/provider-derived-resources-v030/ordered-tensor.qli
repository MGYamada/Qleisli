use std::state::init0;

unitary fn eighth(q: Q<Bit>) -> Q<Bit> { phase[1,3](q) }
unitary fn apply[const U: Op<Bit>](q: Q<Bit>) -> Q<Bit> requires Applicable(U) { U(q) }

unitary fn apply_pair[const U: Op<(Bit,Bit)>](q: Q<(Bit,Bit)>) -> Q<(Bit,Bit)> requires Applicable(U) { U(q) }
unitary fn logical(q: Q<(Bit,Bit)>) -> Q<(Bit,Bit)> {
    let (left,right) = split(q);
    join(phase[1,3](left), phase[7,3](right))
}

pub observe fn main() -> (Bit,Bit) {
    let input = join(init0(), init0());
    let q = clean(input, logical) { |data, scratch| (apply_pair[tensor_op(eighth,adjoint(eighth))](data), scratch) };
    let (left,right) = split(q);
    (measure_z(left),measure_z(right))
}
