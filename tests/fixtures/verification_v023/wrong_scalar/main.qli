use std::quantum::{init0, h, t, x, z};
use std::observe::measure_z;

// Deliberately wrong -TH: probability agreement does not establish exact phase.
unitary fn ht(q: Q<Bit>) -> Q<Bit> { z(x(z(x(t(h(q)))))) }

observe fn main() -> CBit {
    measure_z(ht(init0()))
}
