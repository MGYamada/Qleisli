// Selected symbol: TwoBitstringSuperposition_Reference
use std::quantum::split;
use std::quantum::join;
use std::quantum::cnot;
use std::quantum::h;
use std::quantum::x;

pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, d) = split(q);
    let (a, b) = split(ab);
    let (a, b) = cnot(h(a), b);
    join(join(a, x(b)), x(d))
}
