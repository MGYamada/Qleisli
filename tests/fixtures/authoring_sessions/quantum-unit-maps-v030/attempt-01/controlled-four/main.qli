use std::quantum::unit;
use std::quantum::finish;
use std::quantum::phase_eighth;
unitary fn scalar(q: Q<Unit>) -> Q<Unit> { unit(finish(phase_eighth(q))) }
pub unitary fn f(c: Q<Bit>, q: Q<Unit>) -> (Q<Bit>, Q<Unit>) { controlled(repeat_op(4,scalar))(c,q) }

observe fn main() -> Unit { () }
