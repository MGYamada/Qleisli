// Selected symbol: U_B



use std::gate::s;


unitary fn rz(q: Q<Bit>) -> Q<Bit> { adjoint(global_phase_eighth)(s(q)) }
unitary fn rx(q: Q<Bit>) -> Q<Bit> { h(rz(h(q))) }
pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    join(rx(a), rx(b))
}
