unitary fn restore(q: Q<Bit>, a: Q<Bit>) -> (Q<Bit>,Q<Bit>) {
    cnot(q,a)
}

observe fn main() -> (Bit,Bit) {
    let (q,a) = cnot(h(init0()),init0());
    let (q,a) = restore(q,a);
    (measure_z(h(q)),measure_z(a))
}
