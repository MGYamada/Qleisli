// Selected symbol(s): TextbookQPE
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::gate::s;


use std::gate::t;


use std::transform::qft2;
unitary fn power0(q: Q<Bit>) -> Q<Bit> { s(q) }
unitary fn power1(q: Q<Bit>) -> Q<Bit> { power(migration_t, 4)(q) }

pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (part2, c) = split(q);
    let (a, b) = split(part2);
    let (a, c) = qif(h(a), c) { 0 => id, 1 => power0 };
    let (b, c) = qif(h(b), c) { 0 => id, 1 => power1 };
    join(adjoint(qft2)(join(a, b)), c)
}

unitary fn migration_t(q: Q<Bit>) -> Q<Bit> { t(q) }

/// Identity on the one-Bit target of a coherent branch.
unitary fn id(q: Q<Bit>) -> Q<Bit> { q }
