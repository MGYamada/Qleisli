{"evidence":[{"identity":{"implementation":"main::direct_z","sources":[0,1,2,3,4],"specification":"meaning main::ZMeaning"},"implementation":1,"signature":{"tag":"bit"},"specification":2,"tag":"circuit"},{"identity":{"implementation":"main::fourth_t","sources":[0,1,2,3,4],"specification":"meaning main::ZMeaning"},"implementation":3,"signature":{"tag":"bit"},"specification":4,"tag":"circuit"}],"format":"qleisli.finite-ir","profile":"finite-meaning-v1","programs":[{"classical_inputs":[],"classical_outputs":[0,1,2],"declared_effect":"observe","operations":[{"output":0,"tag":"init0","wire":0},{"gate":"h","input":0,"output":1,"tag":"gate"},{"output":2,"tag":"init0","wire":1},{"gate":"h","input":2,"output":3,"tag":"gate"},{"gate":"t","input":3,"output":4,"tag":"gate"},{"output":5,"tag":"init0","wire":2},{"control":4,"control_out":6,"tag":"cnot","target":5,"target_out":7},{"input":7,"output":8,"steps":[{"action":{"adjoint":false,"evidence":0,"indices":[0],"tag":"contract"},"controls":[]}],"tag":"apply_unitary"},{"left":1,"output":9,"right":8,"tag":"join"},{"input":9,"output":10,"steps":[{"action":{"adjoint":false,"evidence":1,"indices":[1],"tag":"contract"},"controls":[{"index":0,"when_one":true}]}],"tag":"apply_unitary"},{"input":10,"left":11,"left_bits":1,"right":12,"tag":"split"},{"left":11,"output":13,"right":12,"tag":"join"},{"input":13,"output":14,"steps":[{"action":{"indices":[1],"permutation":[0,1],"phases":[0,4],"tag":"monomial"},"controls":[{"index":0,"when_one":true}]}],"tag":"apply_unitary"},{"input":14,"left":15,"left_bits":1,"right":16,"tag":"split"},{"gate":"z","input":16,"output":17,"tag":"gate"},{"control":6,"control_out":18,"tag":"cnot","target":17,"target_out":19},{"gate":"h","input":15,"output":20,"tag":"gate"},{"input":20,"output":0,"tag":"measure_z"},{"gate":"t","input":18,"output":21,"tag":"gate"},{"gate":"t","input":21,"output":22,"tag":"gate"},{"gate":"t","input":22,"output":23,"tag":"gate"},{"gate":"t","input":23,"output":24,"tag":"gate"},{"gate":"t","input":24,"output":25,"tag":"gate"},{"gate":"t","input":25,"output":26,"tag":"gate"},{"gate":"t","input":26,"output":27,"tag":"gate"},{"gate":"h","input":27,"output":28,"tag":"gate"},{"input":28,"output":1,"tag":"measure_z"},{"input":19,"output":2,"tag":"measure_z"}],"quantum_inputs":[],"quantum_outputs":[]},{"classical_inputs":[],"classical_outputs":[],"declared_effect":"unitary","operations":[{"gate":"z","input":0,"output":1,"tag":"gate"}],"quantum_inputs":[{"shape":{"bits":1},"token":0,"wires":[0]}],"quantum_outputs":[1]},{"classical_inputs":[],"classical_outputs":[],"declared_effect":"unitary","operations":[{"input":0,"output":1,"steps":[{"action":{"indices":[0],"permutation":[0,1],"phases":[0,4],"tag":"monomial"},"controls":[]}],"tag":"apply_unitary"}],"quantum_inputs":[{"shape":{"bits":1},"token":0,"wires":[0]}],"quantum_outputs":[1]},{"classical_inputs":[],"classical_outputs":[],"declared_effect":"unitary","operations":[{"input":0,"output":1,"steps":[{"action":{"indices":[0],"permutation":[0,1],"phases":[0,1],"tag":"monomial"},"controls":[]},{"action":{"indices":[0],"permutation":[0,1],"phases":[0,1],"tag":"monomial"},"controls":[]},{"action":{"indices":[0],"permutation":[0,1],"phases":[0,1],"tag":"monomial"},"controls":[]},{"action":{"indices":[0],"permutation":[0,1],"phases":[0,1],"tag":"monomial"},"controls":[]}],"tag":"apply_unitary"}],"quantum_inputs":[{"shape":{"bits":1},"token":0,"wires":[0]}],"quantum_outputs":[1]},{"classical_inputs":[],"classical_outputs":[],"declared_effect":"unitary","operations":[{"input":0,"output":1,"steps":[{"action":{"indices":[0],"permutation":[0,1],"phases":[0,4],"tag":"monomial"},"controls":[]}],"tag":"apply_unitary"}],"quantum_inputs":[{"shape":{"bits":1},"token":0,"wires":[0]}],"quantum_outputs":[1]}],"root":0,"root_interface":null,"sources":[{"path":"main","text":"// Copyright 2026 Masahiko G. Yamada. SPDX-License-Identifier: Apache-2.0.\u000ause std::quantum::{init0,h,x,z,t,tdg,cnot,join,split};\u000ause std::observe::measure_z;\u000a\u000abasis fn z_phase(b: Bit) -> (Bit,(Bit,Bit)) { (0,(0,b)) }\u000ameaning ZMeaning: Bit = phase_by(z_phase);\u000aunitary fn direct_z(q: Q<Bit>) -> Q<Bit> { z(q) }\u000aunitary fn fourth_t(q: Q<Bit>) -> Q<Bit> { repeat_static(4,t,q) }\u000aunitary fn identity(q: Q<Bit>) -> Q<Bit> { q }\u000aunitary fn apply_gate[static U: Op<Bit>](q: Q<Bit>) -> Q<Bit>\u000arequires Apply(U) { U(q) }\u000aunitary fn apply_pair[static U: Op<(Bit,Bit)>](q: Q<(Bit,Bit)>) -> Q<(Bit,Bit)>\u000arequires Apply(U) { U(q) }\u000a\u000apub unitary fn probe(q: Q<Bit>) -> Q<Bit> {\u000a    apply_gate[bind_op(direct_z,ZMeaning)](q)\u000a}\u000apub observe fn main() -> (Bit,Bit,Bit) {\u000a    let c = h(init0());\u000a    let (r,q) = cnot(t(h(init0())),init0());\u000a    let q = apply_gate[bind_op(direct_z,ZMeaning)](q);\u000a    let pair = apply_pair[controlled_op(bind_op(fourth_t,ZMeaning))](join(c,q));\u000a    let (c,q) = split(pair);\u000a    // Independent explicit inverse uses the sealed Z action, not checked evidence.\u000a    let (c,q) = qif(c,q) { 0 => identity, 1 => direct_z };\u000a    let q = z(q);\u000a    let (r,q) = cnot(r,q);\u000a    (measure_z(h(c)),measure_z(h(tdg(r))),measure_z(q))\u000a}\u000a"},{"path":"std::basis","text":"//! Total finite basis functions, implemented as ordinary checked source.\u000a//!\u000a//! These functions take basis labels, not quantum owners or measurement results.\u000a//! Importing them grants no quantum primitive or verification privilege.\u000a//! Contracts and finite regression status: Contract identifiers: B001-B002.\u000a\u000a/// Return x xor y for all four pairs of Bit inputs.\u000a/// This two-argument map is total but not injective on the product domain.\u000a/// A coherent lift must check injectivity of its complete enclosing map.\u000apub basis fn xor2(x: Bit, y: Bit) -> Bit { x xor y }\u000a\u000a/// Return x and y for all four pairs of Bit inputs.\u000a/// This total, noninjective predicate can describe reversible XOR computation\u000a/// into an auxiliary; calling it does not measure a quantum register.\u000apub basis fn and2(x: Bit, y: Bit) -> Bit { x and y }\u000a"},{"path":"std::measurement","text":"//! Complete measurement instruments, implemented as ordinary checked source.\u000a//!\u000a//! Logical owners and external-reference behavior follow each declared contract.\u000a//! Contract identifiers: R003-R005.\u000ause std::quantum::init0;\u000ause std::quantum::h;\u000ause std::quantum::cnot;\u000ause std::quantum::split;\u000ause std::observe::measure_z;\u000a\u000a/// Measure the X eigenvalue (-1)^b and return the classical result b.\u000a/// Consume the target owner; interpret the measurement with all references.\u000apub fn measure_x(q: Q<Bit>) -> Bit {\u000a    measure_z(h(q))\u000a}\u000a\u000a/// Measure both bits in Z and consume both quantum owners.\u000a/// Return (left result, right result), corresponding to register weights 1,2.\u000apub fn measure_z2(q: Q<(Bit, Bit)>) -> (Bit, Bit) {\u000a    let (a, b) = split(q);\u000a    (measure_z(a), measure_z(b))\u000a}\u000a\u000a/// Measure Z(a) Z(b), consuming the internal meter and returning both data owners.\u000a/// For result s, the data projector is (I + (-1)^s Z tensor Z)/2.\u000a/// Preserve coherence within each parity subspace and return ((a,b),s).\u000a/// Inputs must be distinct owners, but may be entangled with each other or a reference.\u000apub fn parity_zz(a: Q<Bit>, b: Q<Bit>) -> ((Q<Bit>, Q<Bit>), Bit) {\u000a    let meter = init0();\u000a    let (a, meter) = cnot(a, meter);\u000a    let (b, meter) = cnot(b, meter);\u000a    ((a, b), measure_z(meter))\u000a}\u000a"},{"path":"std::reflection","text":"//! Phase-fixed reflections, implemented as ordinary checked source.\u000a//!\u000a//! Inputs may be entangled with external references; no product-state promise.\u000a//! Contract identifier: R002. Private basis helpers grant no evidence privilege.\u000ause std::transform::hadamard2;\u000ause std::quantum::z;\u000a\u000a/// Return 0 exactly on (0,0), and 1 on every other pair of basis labels.\u000a/// Computing this predicate and applying Z to its auxiliary gives phase +1\u000a/// on 00 and -1 elsewhere: 2|00><00| - I, including its sign.\u000abasis fn nonzero2((a, b): (Bit, Bit)) -> Bit { not (not a and not b) }\u000a\u000a/// Apply the phase-fixed reflection 2|s><s| - I, with |s> = (H tensor H)|00>.\u000a/// Consume and return the two data owners with no input-state promise.\u000a/// The protected computed scope checks zero return of its temporary auxiliary;\u000a/// the name of this routine and this documentation do not grant that evidence.\u000apub fn reflect_uniform2(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {\u000a    let q = hadamard2(q);\u000a    let q = with_computed(q, nonzero2) { |ancilla| z(ancilla) };\u000a    hadamard2(q)\u000a}\u000a"},{"path":"std::transform","text":"//! Coherent Hadamard and fixed positive-phase Fourier transformations.\u000a//!\u000a//! Ordinary checked .qli definitions; no general-size or approximate QFT API.\u000a//! Fourier basis labels are little-endian; Fourier circuits include output-bit reversal.\u000a//! Contracts and finite regression status: F001-F002 and R001.\u000ause std::quantum::h;\u000ause std::quantum::t;\u000ause std::quantum::s;\u000ause std::quantum::id;\u000ause std::quantum::split;\u000ause std::quantum::join;\u000a\u000a/// Apply H tensor H to a two-bit register, preserving both owners and order.\u000a/// This unitary has no input-state promise and uses no auxiliary.\u000apub fn hadamard2(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {\u000a    let (a, b) = split(q);\u000a    join(h(a), h(b))\u000a}\u000a\u000a/// Apply F4: |x> maps to sum_y exp(2*pi*i*x*y/4)|y>/2 for every input.\u000a/// The leftmost bit has weight 1; output reversal is part of the exact unitary.\u000a/// Consume and return both owners without measurement or auxiliary allocation.\u000apub fn qft2(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {\u000a    let (a, b) = split(q);\u000a    let b = h(b);\u000a    let (a, b) = qif(a, b) { 0 => id, 1 => s };\u000a    let a = h(a);\u000a    join(b, a)\u000a}\u000a\u000a/// Apply F8: |x> maps to sum_y exp(2*pi*i*x*y/8)|y>/sqrt(8) for every input.\u000a/// For input ((a,b),c), x = a + 2*b + 4*c; output reversal is included.\u000a/// Consume and return all three owners with no measurement or auxiliary.\u000apub fn qft3(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {\u000a    let (ab, c) = split(q);\u000a    let (a, b) = split(ab);\u000a    let c = h(c);\u000a    let (b, c) = qif(b, c) { 0 => id, 1 => s };\u000a    let (a, c) = qif(a, c) { 0 => id, 1 => t };\u000a    let b = h(b);\u000a    let (a, b) = qif(a, b) { 0 => id, 1 => s };\u000a    let a = h(a);\u000a    join(join(c, b), a)\u000a}\u000a"}],"version":2}
