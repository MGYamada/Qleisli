pub unitary fn f(q:Q<(Unit,Bit)>)->Q<Bit>{basis q as ((),x) {x}}
unitary fn inverse(q:Q<Bit>)->Q<(Unit,Bit)>{basis q as x {((),x)}}
unitary fn right(q:Q<(Bit,Unit)>)->Q<Bit>{basis q as (x,()) {x}}

observe fn main()->Unit{()}
