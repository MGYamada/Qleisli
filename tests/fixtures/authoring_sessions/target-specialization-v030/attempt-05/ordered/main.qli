use std::state::init0;

unitary fn wrapped_phase(data: Q<(Unit, Bit)>) -> Q<(Unit, Bit)> {
    let (tag, wire) = split(data);
    join(tag, phase[1,3](wire))
}

unitary fn bit_phase(bit: Q<Bit>) -> Q<Bit> { phase[7,3](bit) }

unitary fn apply_pair[const A: Basis, const B: Basis, const U: Op<A>, const V: Op<B>](
    left: Q<A>, right: Q<B>,
) -> (Q<A>, Q<B>) requires Applicable(U), Applicable(V) {
    (U(left), V(right))
}

unitary fn logical(data: Q<((Unit, Bit), Bit)>) -> Q<((Unit, Bit), Bit)> {
    let (left, right) = split(data);
    join(wrapped_phase(left), bit_phase(right))
}

pub observe fn main() -> (Bit, Bit) {
    let input = join(join(unit(()), init0()), init0());
    let output = clean(input, logical) { |data, scratch|
        let (left, right) = split(data);
        let (left, right) = apply_pair[type((Unit, Bit)), type(Bit), wrapped_phase, bit_phase](left, right);
        (join(left, right), scratch)
    };
    let (left, right) = split(output);
    let (tag, bit) = split(left);
    finish(tag);
    (measure_z(bit), measure_z(right))
}
