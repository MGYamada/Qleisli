// Selected symbol(s): circuit / DoubleExcitation
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::z;
basis fn occupied((((a, b), c), d): (((Bit, Bit), Bit), Bit)) -> Bit { a and b and not c and not d }
basis fn flip(a: Bit, b: Bit, c: Bit, d: Bit) -> Bit {
    (a and b and not c and not d) xor (not a and not b and c and d)
}
basis fn swap_excitation(a: Bit, b: Bit, c: Bit, d: Bit) -> (((Bit, Bit), Bit), Bit) {
    (((a xor flip(a,b,c,d), b xor flip(a,b,c,d)), c xor flip(a,b,c,d)), d xor flip(a,b,c,d))
}
pub unitary fn kernel(q: Q<(((Bit, Bit), Bit), Bit)>) -> Q<(((Bit, Bit), Bit), Bit)> {
    let q = with_computed(q, occupied) { |flag| z(flag) };
    do (((a, b), c), d) <- q;
    pure swap_excitation(a, b, c, d)
}
