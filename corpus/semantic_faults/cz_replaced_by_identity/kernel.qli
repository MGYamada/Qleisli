// Deliberate type-correct semantic mutation: Replace CZ by identity: all ordinary basis probabilities agree, but the |11> phase and controlled interference differ.

use std::quantum::z;
use std::quantum::id;
use std::quantum::join;
use std::quantum::split;

pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    // Deliberate fault: CZ phase omitted.
    join(a, b)
}
