use std::gate::z;
use std::gate::s;
use std::gate::sdg;



pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    join(z(h(a)), s(h(b)))
}
