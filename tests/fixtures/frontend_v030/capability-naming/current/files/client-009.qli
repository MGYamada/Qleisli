fn eligibility_barrier[const A: Basis](q: Q<A>) -> Q<A> { q }
fn forwards[const U: Op<Bit>](q: Q<Bit>) -> Q<Bit>
requires Applicable(U) { U(q) }
fn control[const W: Op<Bit>](c: Q<Bit>, q: Q<Bit>) -> (Q<Bit>,Q<Bit>)
requires Controllable(W) { controlled(W)(c,q) }
pub fn probe[const V: Op<Bit>](c: Q<Bit>, q: Q<Bit>) -> (Q<Bit>,Q<Bit>)
requires Applicable(V), Adjointable(V), Controllable(V) { control[forwards[V]](c,q) }
