// Selected symbol(s): circuit
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::init0;
use std::quantum::h;
use std::quantum::x;
use std::quantum::z;
use std::quantum::t;
use std::quantum::cnot;
use std::quantum::toffoli;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;
basis fn one(a: Bit) -> Bit { 1 }
// This scalar is needed: S alone is not RZ(pi/2) under control.
unitary fn scalar(q: Q<Bit>) -> Q<Bit> {
    with_computed(q, one) { |flag| t(t(t(t(t(t(t(flag))))))) }
}
unitary fn rz_quarter(q: Q<Bit>) -> Q<Bit> { scalar(repeat_static(2, t, q)) }
unitary fn rx_quarter(q: Q<Bit>) -> Q<Bit> { h(rz_quarter(h(q))) }
unitary fn ry_quarter(q: Q<Bit>) -> Q<Bit> { h(z(q)) }

pub unitary fn kernel(q: Q<Bit>) -> Q<Bit> {
    let a = q;
    ry_quarter(rx_quarter(a))
}
