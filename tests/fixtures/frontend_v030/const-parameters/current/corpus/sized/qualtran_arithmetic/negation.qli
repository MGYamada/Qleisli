// Adapted from retained Qualtran Equals; see README.md.
use std::quantum::x;
use std::registers::take_bit;
use std::registers::put_bit;

/// Bitwise complement with phase +1, retaining the empty register owner.
pub unitary fn invert_bits[const n: Nat](q: Q<Bits<n>>) -> Q<Bits<n>> {
    qfor static k in 0..n carry register = q {
        let (bit,rest) = take_bit[n,k](register);
        yield put_bit[n,k](x(bit),rest);
    }
}
