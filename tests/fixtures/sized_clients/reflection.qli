use std::quantum::phase;
use std::registers::take_bit;
use std::registers::put_bit;

/// Z on the low bit, identity on spectators; exact phase convention diag(1,-1).
pub unitary fn reflect_low[static n: Nat](q: Q<Bits<n>>) -> Q<Bits<n>>
requires n >= 1 {
    let (bit,rest) = take_bit[n,0](q);
    put_bit[n,0](phase[1,1](bit),rest)
}
