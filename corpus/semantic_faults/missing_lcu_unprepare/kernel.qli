// Selected symbol(s): lcu_circuit (Application: Projectors)
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::h;
use std::quantum::z;
use std::quantum::join;
use std::quantum::split;

unitary fn identity(q: Q<Bit>) -> Q<Bit> { q }
pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (selector, data) = split(q);
    let selector = h(selector);
    let (selector, data) = qif(selector, data) { 0 => identity, 1 => z };
    join(selector, data)
}
