private def common : Bits 4 ≃ Bool × (Bits 1 × (Bits 1 × Bits 1)) where
  toFun bits := (bits 2,(fun _ => bits 0,(fun _ => bits 3,fun _ => bits 1)))
  invFun pair := ![pair.2.1 0,pair.2.2.2 0,pair.1,pair.2.2.1 0]
  left_inv bits := by funext i; fin_cases i <;> rfl
  right_inv pair := by
    rcases pair with ⟨c,a,b,r⟩
    apply Prod.ext
    · rfl
    · apply Prod.ext
      · funext i; fin_cases i; rfl
      · apply Prod.ext <;> funext i <;> fin_cases i <;> rfl

private def normalTail : Bits 2 ≃ Bits 1 × Bits 1 where
  toFun bits := (fun _ => bits 0,fun _ => bits 1)
  invFun pair := ![pair.1 0,pair.2 0]
  left_inv bits := by funext i; fin_cases i <;> rfl
  right_inv pair := by
    rcases pair with ⟨a,b⟩
    apply Prod.ext <;> funext i <;> fin_cases i <;> rfl

private def reversedTail : Bits 2 ≃ Bits 1 × Bits 1 :=
  normalTail.trans (Equiv.prodComm _ _)

private def emitted_frames
    {leavesA leavesB : HierarchicalFiniteEvaluation.Leaves Operator}
    (p : Premises leavesA ab aSpine 4 1 1 2 2)
    (q : Premises leavesB ba bSpine 4 1 1 2 2)
    (ae : p.enterAxes = [2,0,1,3]) (am : p.middleAxes = [0,3,1,2])
    (be : q.enterAxes = [2,3,0,1]) (bm : q.middleAxes = [0,2,1,3]) :
    Frames p q 1 := by
  refine ⟨common,reversedTail,normalTail,normalTail,normalTail,?_,?_,?_,?_⟩
  all_goals
    intro bits
    simp [Premises.firstRoute,Premises.secondRoute,Equiv.trans_apply,axisEquiv,
      QleisliKernel.Layout.reindex,QleisliKernel.Layout.indexAt,ae,am,be,bm,
      common,normalTail,reversedTail,List.ofFn_succ]

/-- Conditional on the actual typing/wiring/provider/evaluation premises for
the two literal original artifacts. No source lowering theorem is inferred. -/
theorem emitted_entry_exchange
    {leavesA leavesB : HierarchicalFiniteEvaluation.Leaves Operator}
    (p : Premises leavesA ab aSpine 4 1 1 2 2)
    (q : Premises leavesB ba bSpine 4 1 1 2 2)
    (ae : p.enterAxes = [2,0,1,3]) (am : p.middleAxes = [0,3,1,2])
    (be : q.enterAxes = [2,3,0,1]) (bm : q.middleAxes = [0,2,1,3])
    (sameU : matrixAt 1 1 p.U = matrixAt 1 1 q.V)
    (sameV : matrixAt 1 1 p.V = matrixAt 1 1 q.U)
    (fuelA fuelB : Nat) (actualA actualB : Operator)
    (ha : HierarchicalFiniteEvaluation.physical algebra leavesA ab fuelA ab.entry.implementation = some actualA)
    (hb : HierarchicalFiniteEvaluation.physical algebra leavesB ba fuelB ba.entry.implementation = some actualB) :
    matrixAt 4 4 actualA = matrixAt 4 4 actualB :=
  actual_exchange p q 1 (emitted_frames p q ae am be bm) sameU sameV fuelA fuelB actualA actualB ha hb

private def topological (artifact : Artifact) : Array Nat :=
  Array.range (artifact.definitions.size+artifact.meanings.size+artifact.encodings.size+artifact.proofs.size)

private def validate (label : String) (artifact : Artifact) (routes : Array Nat)
    (expected : List (Nat × List Nat)) : IO Unit := do
  let typed ← match NodeTyping.checkAll artifact (topological artifact) with
    | .error failure => throw (IO.userError s!"{label}: typing failed: {repr failure}")
    | .ok typed => pure typed
  let wire ← match Wiring.inspect artifact routes 2000000 with
    | .error failure => throw (IO.userError s!"{label}: wiring failed: {repr failure}")
    | .ok state => pure state
  for (index,axes) in expected do
    unless (wire.cache[index]?).bind id == some axes do
      throw (IO.userError s!"{label}: wrong original route {index}")
    unless decide (QleisliKernel.Layout.Permutation axes.length axes (Ports.inverse axes.length axes.toArray)) do
      throw (IO.userError s!"{label}: missing two-sided computed inverse at {index}")
  let enterAxes := (wire.cache[24]?).bind id
  let middleAxes := (wire.cache[27]?).bind id
  let leaveAxes := (wire.cache[30]?).bind id
  let composed := do
    let first ← enterAxes
    let second ← middleAxes
    let last ← leaveAxes
    let pair ← Wiring.compose first second
    Wiring.compose pair last
  unless composed == some (List.range 4) do
    throw (IO.userError s!"{label}: final route is not the actual composite inverse")
  let pending ← match Conditional.checkAll artifact (topological artifact) with
    | .error failure => throw (IO.userError s!"{label}: conditional check failed: {repr failure}")
    | .ok checked => pure checked
  let (finite,left) := (QleisliKernel.Protocol.HierarchicalFinite.checkLeaves pending.state.requests).run 10000000
  match finite with
  | .error failure => throw (IO.userError s!"{label}: original finite leaf failed: {repr failure}")
  | .ok _ => pure ()
  IO.println s!"PASS: {label}; typed visits={typed.totalVisits}; wiring visits={wire.visits}; finite work={10000000-left}; seven original wiring summaries/computed inverses checked"

#eval validate "actual-ab" ab #[9,22,24,25,27,28,30]
  [(9,[0,1]),(22,[0,1]),(24,[2,0,1,3]),(25,[0,1]),(27,[0,3,1,2]),(28,[0,1]),(30,[2,3,0,1])]
#eval validate "actual-ba" ba #[11,22,24,25,27,28,30]
  [(11,[0,1]),(22,[0,1]),(24,[2,3,0,1]),(25,[0,1]),(27,[0,2,1,3]),(28,[0,1]),(30,[1,3,0,2])]

-- A bijective final route can still be the wrong inverse for the comparison.
-- This is the actual route emitted by the valid source returning (r,a,c,b).
example : QleisliKernel.Layout.Permutation 4 [3,2,0,1] (Ports.inverse 4 #[3,2,0,1]) := by decide
example : (do
    let pair ← Wiring.compose [2,0,1,3] [0,3,1,2]
    Wiring.compose pair [3,2,0,1]) = some [1,0,2,3] := by decide
example : [1,0,2,3] ≠ List.range 4 := by decide

#print axioms emitted_entry_exchange
