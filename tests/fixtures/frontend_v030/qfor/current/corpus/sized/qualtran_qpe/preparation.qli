use std::quantum::h;
use std::registers::take_bit;
use std::registers::put_bit;

/// H tensor n on all inputs; no initial-state premise.
pub unitary fn hadamard_bits[static n: Nat](q: Q<Bits<n>>) -> Q<Bits<n>> {
    qfor static k in 0..n carry register = q {
        let (bit,rest) = take_bit[n,k](register);
        let bit = h(bit);
        yield put_bit[n,k](bit,rest);
    }
}
