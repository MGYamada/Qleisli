    "python": {
      "command": [
        "python3",
        "--version"
      ],
      "pattern": "Python 3\\.(1[1-9]|[2-9][0-9])\\.[0-9]+"
    },
    "rust-latest": {
      "command": [
        "rustc",
        "--version"
      ],
      "pattern": "rustc 1\\.98\\.1 .*"
    },
    "cargo-latest": {
      "command": [
        "cargo",
        "--version"
      ],
      "pattern": "cargo 1\\.98\\.1 .*"
    },
    "cargo-msrv": {
      "command": [
        "python3",
        "scripts/run_msrv.py",
        "--version"
      ],
      "pattern": "cargo 1\\.85\\.0 .*"
    },
    "clippy-msrv": {
      "command": [
        "python3",
        "scripts/run_msrv.py",
        "clippy",
        "--version"
      ],
      "pattern": "clippy 0\\.1\\.85 .*"
    },
    "lean": {
      "command": [
        "lake",
        "-d",
        "lean-kernel",
        "env",
        "lean",
        "--version"
      ],
      "pattern": "Lean \\(version 4\\.30\\.0,.*"
    },
    "mdbook": {
      "command": [
        "mdbook",
        "--version"
      ],
      "pattern": "mdbook v0\\.5\\.4"
    },
    "git": {
      "command": [
        "git",
        "--version"
      ],
      "pattern": "git version .*"
    },
    "rust-msrv": {
      "command": [
        "rustup",
        "run",
        "1.85.0",
        "rustc",
        "--version"
      ],
      "pattern": "rustc 1\\.85\\.0 .*"
    }
  }
