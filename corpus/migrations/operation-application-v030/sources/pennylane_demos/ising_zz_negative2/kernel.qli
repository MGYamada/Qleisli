// Selected symbol(s): U_C(gamma), single-edge factor
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::s;
use std::quantum::phase_eighth;
use std::quantum::cnot;
use std::quantum::split;
use std::quantum::join;

pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    let (a, b) = cnot(a, b);
    let b = phase_eighth(inverse(s)(b));
    let (a, b) = cnot(a, b);
    join(a, b)
}
