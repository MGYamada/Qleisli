use std::quantum::split;
use std::quantum::join;
use std::quantum::id;
use std::quantum::s;
fn quarter(q: Q<(Bit,Bit)>) -> Q<(Bit,Bit)> {
    let (c,q) = split(q);
    let (c,q) = qif(c,q) { 0 => id, 1 => s };
    join(c,q)
}
fn sized_identity[static n: Nat](q: Q<Bits<n>>) -> Q<Bits<n>> {
    for static i in 0..n carry a=q { yield a }
}
pub fn main() -> Unit { () }
