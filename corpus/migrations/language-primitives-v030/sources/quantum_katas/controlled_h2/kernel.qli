pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    let (a, b) = qif(h(a), b) { 0 => id, 1 => hadamard_bit };
    join(a, b)
}

/// Identity on the one-Bit target of a coherent branch.
unitary fn id(q: Q<Bit>) -> Q<Bit> { q }

/// Closed Hadamard provider for the one-Bit coherent branch.
unitary fn hadamard_bit(q: Q<Bit>) -> Q<Bit> { h(q) }
