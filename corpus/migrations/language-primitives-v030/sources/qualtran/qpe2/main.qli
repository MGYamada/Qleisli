// Selected symbol(s): TextbookQPE
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::state::init0;
use std::gate::x;



use kernel::kernel;

observe fn main() -> ((Bit, Bit), Bit) {
    let q = kernel(join(join(init0(), init0()), x(init0())));
    let (part2, c) = split(q);
    let (a, b) = split(part2);
    ((measure_z(a), measure_z(b)), measure_z(c))
}
