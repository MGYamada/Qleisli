//! Estimate phase 6/8; print the weight-one bit first and retain the target.
use estimation::phase3;
use gates::eighth_phase;
use std::quantum::init0;
use std::quantum::x;
use std::observe::measure_z;
observe fn main() -> ((Bit,Bit,Bit),Bit) {
    let (phase_word,target) = phase3[power(eighth_phase,6)](x(init0()));
    (phase_word,measure_z(target))
}
