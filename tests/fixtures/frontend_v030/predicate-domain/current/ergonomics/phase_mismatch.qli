//! Deliberately wrong phase target: the unchanged AND oracle must fail binding.
use std::quantum::init0;
use std::quantum::x;
use std::quantum::z;
use std::quantum::join;
use std::routines::measure_z2;
basis fn phase((a,b): (Bit,Bit)) -> (Bit,(Bit,Bit)) { (0,(0,a xor b)) }
meaning Mark11: (Bit,Bit) = phase_by(phase);
basis fn marked((a,b): (Bit,Bit)) -> Bit { a and b }
unitary fn oracle(q: Q<(Bit,Bit)>) -> Q<(Bit,Bit)> {
    with_computed(q,marked) { |flag| z(flag) }
}
unitary fn apply[static U: Op<(Bit,Bit),Mark11>](q: Q<(Bit,Bit)>) -> Q<(Bit,Bit)>
requires Apply(U) { U(q) }
observe fn main() -> (CBit,CBit) {
    measure_z2(apply[bind_op(oracle,Mark11)](join(x(init0()),x(init0()))))
}
