use std::quantum::h;
use std::quantum::id;
use std::quantum::z;
use std::quantum::split;
use std::quantum::join;

pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    let (a, b) = qif(h(a), h(b)) { 0 => id, 1 => id };
    join(a, b)
}
