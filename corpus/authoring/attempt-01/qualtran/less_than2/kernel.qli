use std::quantum::init0;
use std::quantum::h;
use std::quantum::x;
use std::quantum::z;
use std::quantum::t;
use std::quantum::cnot;
use std::quantum::toffoli;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;
basis fn compare(a: Bit, b: Bit, c: Bit, d: Bit, flag: Bit) -> (Bit, Bit, Bit, Bit, Bit) {
    (a, b, c, d, flag xor ((not b and d) or ((not (b xor d)) and not a and c)))
}
pub unitary fn kernel(q: Q<(Bit, Bit, Bit, Bit, Bit)>) -> Q<(Bit, Bit, Bit, Bit, Bit)> {
    do (a, b, c, d, flag) <- q;
    pure compare(a, b, c, d, flag)
}
