  ("std::transform","//! Coherent Hadamard and fixed positive-phase Fourier transformations.\n//!\n//! Ordinary checked .qli definitions; no general-size or approximate QFT API.\n//! Fourier basis labels are little-endian; Fourier circuits include output-bit reversal.\n//! Contracts and finite regression status: F001-F002 and R001.\nuse std::gate::t;\nuse std::gate::s;\nuse std::gate::id;\n\n/// Fixed Bit identity for the zero arm of a coherent conditional.\n/// Instantiate the Basis argument before selecting the provider.\nunitary fn bit_identity(q: Q<Bit>) -> Q<Bit> { id[type(Bit)](q) }\n\n/// Apply H tensor H to a two-bit register, preserving both owners and order.\n/// This unitary has no input-state promise and uses no auxiliary.\npub unitary fn hadamard2(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {\n    let (a, b) = split(q);\n    join(h(a), h(b))\n}\n\n/// Apply F4: |x> maps to sum_y exp(2*pi*i*x*y/4)|y>/2 for every input.\n/// The leftmost bit has weight 1; output reversal is part of the exact unitary.\n/// Consume and return both owners without measurement or auxiliary allocation.\npub unitary fn qft2(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {\n    let (a, b) = split(q);\n    let b = h(b);\n    let (a, b) = qif(a, b) { 0 => bit_identity, 1 => s };\n    let a = h(a);\n    join(b, a)\n}\n\n/// Apply F8: |x> maps to sum_y exp(2*pi*i*x*y/8)|y>/sqrt(8) for every input.\n/// For input ((a,b),c), x = a + 2*b + 4*c; output reversal is included.\n/// Consume and return all three owners with no measurement or auxiliary.\npub unitary fn qft3(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {\n    let (ab, c) = split(q);\n    let (a, b) = split(ab);\n    let c = h(c);\n    let (b, c) = qif(b, c) { 0 => bit_identity, 1 => s };\n    let (a, c) = qif(a, c) { 0 => bit_identity, 1 => t };\n    let b = h(b);\n    let (a, b) = qif(a, b) { 0 => bit_identity, 1 => s };\n    let a = h(a);\n    join(join(c, b), a)\n}\n")
