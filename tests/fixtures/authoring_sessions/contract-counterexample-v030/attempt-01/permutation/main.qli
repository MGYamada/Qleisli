use std::gate::cnot;
use std::structure::permute_axes;

unitary fn swap_by_cnots(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    let (a, b) = cnot(a, b);
    let (b, a) = cnot(b, a);
    join(a, b)
}

unitary fn swap_spec(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    permute_axes(q)
}

unitary fn client(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    apply_contract(swap_by_cnots, swap_spec, q)
}
