// Selected symbol: XorK; bitsize=3, k=5
use std::quantum::x;
use std::quantum::split;
use std::quantum::join;

pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, c) = split(q);
    let (a, b) = split(ab);
    join(join(x(a), b), x(c))
}
