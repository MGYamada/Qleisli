use std::gate::x;
use std::gate::cnot;



pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, c) = split(q);
    let (a, b) = split(ab);
    let (b, c) = cnot(h(b), c);
    let (a, c) = cnot(h(a), c);
    join(join(a, b), x(c))
}
