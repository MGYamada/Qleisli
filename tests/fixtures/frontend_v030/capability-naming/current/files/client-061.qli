fn eligibility_barrier[const A: Basis](q: Q<A>) -> Q<A> { q }
fn backwards[const U: Op<Bit>](q: Q<Bit>) -> Q<Bit>
requires Adjointable(U) { adjoint(U)(q) }
fn inverse[const W: Op<Bit>](q: Q<Bit>) -> Q<Bit>
requires Adjointable(W) { adjoint(W)(q) }
pub fn probe[const V: Op<Bit>](q: Q<Bit>) -> Q<Bit>
requires Applicable(V), Adjointable(V), Controllable(V) { inverse[backwards[V]](q) }
