// Adapted from retained Qualtran AddK/Equals; see README.md.
use controls::all_ones;
use std::registers::take_bit;
use std::registers::put_bit;

/// Add one modulo 2^n with phase +1 and no auxiliary register.
/// Test the original lower bits for carry before incrementing them.
pub unitary fn increment[const n: Nat](q: Q<Bits<n>>) -> Q<Bits<n>> {
    if static n == 0 { q } else {
        let (high,low) = take_bit[n,n-1](q);
        let (low,high) = all_ones[n-1](low,high);
        let low = increment[n-1](low);
        put_bit[n,n-1](high,low)
    }
}
