// Selected symbol: circuit(params)

use std::gate::x;
use std::gate::z;
use std::gate::s;
use std::gate::t;
use std::gate::tdg;


use std::gate::toffoli;
use std::gate::cnot;



unitary fn rz(q: Q<Bit>) -> Q<Bit> { adjoint(global_phase_eighth)(s(q)) }
unitary fn rx(q: Q<Bit>) -> Q<Bit> { h(rz(h(q))) }
pub unitary fn kernel(q: Q<Bit>) -> Q<Bit> { z(h(adjoint(rx)(q))) }
