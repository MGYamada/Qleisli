// Selected symbol(s): ReflectionUsingPrepare
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::h;
use std::quantum::z;
use std::quantum::phase_eighth;
basis fn zero(a: Bit) -> Bit { not a }
use std::quantum::split;
use std::quantum::join;

pub unitary fn kernel(q: Q<Bit>) -> Q<Bit> {
    let q = h(q);
    let q = with_computed(q, zero) { |flag| z(flag) };
    let q = h(q);
    repeat_static(4, phase_eighth, q)
}
