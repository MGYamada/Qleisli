use std::gate::cnot;
unitary fn logical(q: Q<Bit>) -> Q<Bit> { q }
pub unitary fn main(q: Q<Bit>) -> Q<Bit> {
    clean(q, logical) { |data, scratch|
        let (data, scratch) = cnot(data, scratch);
        cnot(data, scratch)
    }
}
