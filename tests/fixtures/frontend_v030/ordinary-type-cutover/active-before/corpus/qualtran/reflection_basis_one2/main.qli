// Selected symbol: ReflectionUsingPrepare
use std::quantum::init0;
use std::quantum::h;
use std::quantum::x;
use std::quantum::t;
use std::quantum::cnot;
use std::quantum::join;
use std::quantum::split;
use std::observe::measure_z;
use kernel::kernel;
observe fn main() -> (CBit, CBit) {
    let q = join(init0(), init0());
    let q = kernel(q);
let (w0, w1) = split(q);
(measure_z(w0), measure_z(w1))
}
