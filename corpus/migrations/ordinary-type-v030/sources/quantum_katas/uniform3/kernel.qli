use std::quantum::h;
use std::quantum::x;
use std::quantum::z;
use std::quantum::s;
use std::quantum::t;
use std::quantum::tdg;
use std::quantum::id;
use std::quantum::phase_eighth;
use std::quantum::toffoli;
use std::quantum::cnot;
use std::quantum::join;
use std::quantum::split;

pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, d) = split(q);
    let (a, b) = split(ab);
    join(join(h(a), h(b)), h(d))
}
