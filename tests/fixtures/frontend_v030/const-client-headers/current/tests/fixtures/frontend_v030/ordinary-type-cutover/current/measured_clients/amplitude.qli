use rotation::prepare;
use amplification::grover;
use measurement::qpe;

/// Prepare the target, then call the same measured QPE with a transparent G.
pub observe fn amplitude_readout[const n: Nat, const m: Nat, const j: Nat, const d: Nat](
    target: Q<Bits<n>>
) -> (Bits<m>, Q<Bits<n>>)
requires n >= 1, m >= 1 {
    let target = prepare[n,j,d](target);
    qpe[n,m,grover[n,j,d]](target)
}
