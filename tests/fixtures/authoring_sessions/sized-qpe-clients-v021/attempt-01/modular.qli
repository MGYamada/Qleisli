use std::registers::take_bit;
use std::registers::put_bit;

/// Multiply by two modulo 2^n-1 on residues; fix the unused all-ones label.
/// This is a phase +1 cyclic rotation, not general modular multiplication.
pub unitary fn mul_two[static n: Nat](q: Q<Bits<n>>) -> Q<Bits<n>>
requires n >= 2 {
    let (high,rest) = take_bit[n,n-1](q);
    put_bit[n,0](high,rest)
}
