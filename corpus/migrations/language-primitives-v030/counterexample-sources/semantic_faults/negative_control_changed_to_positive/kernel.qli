use std::gate::cnot;
use std::gate::x;



pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    let (a, b) = cnot(a, b);
    join(a, b)
}

// Deliberate local semantic mutation: Remove the target X: the control-zero block changes while every owner still returns.
