use std::state::init0;



use kernel::kernel;
use std::gate::x;

observe fn main() -> (Bit, Bit) {
    let q = kernel(join(init0(), x(init0())));
    let (w0, w1) = split(q);
    (measure_z(w0), measure_z(w1))
}
