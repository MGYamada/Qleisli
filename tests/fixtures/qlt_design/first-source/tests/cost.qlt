use qli::std::arithmetic::increment2;
use qli::std::arithmetic::add2;

#[test]
fn increment_logical_gate_count() {
    assert_eq!(cost(increment2).logical_gate_count, 2);
}

#[test]
fn addition_logical_gate_count() {
    assert_eq!(cost(add2).logical_gate_count, 3);
}
