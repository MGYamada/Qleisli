// Selected symbol: ReflectionUsingPrepare
use std::quantum::h;
use std::quantum::x;
use std::quantum::z;
use std::quantum::s;
use std::quantum::t;
use std::quantum::tdg;
use std::quantum::id;
use std::quantum::phase_eighth;
use std::quantum::toffoli;
use std::quantum::cnot;
use std::quantum::join;
use std::quantum::split;

pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    let (a, b) = qif(x(a), x(b)) { 0 => id, 1 => z };
    join(a, x(b))
}
