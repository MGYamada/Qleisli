//! E[(-1)^meter] = 1/sqrt(2) for T on |1>; the target is still |1>.
use interference::imaginary_overlap;
use gates::eighth_phase;
use std::state::init0;
use std::gate::x;

observe fn main() -> (Bit,Bit) {
    let (meter,target) = imaginary_overlap[eighth_phase](x(init0()));
    (meter,measure_z(target))
}
