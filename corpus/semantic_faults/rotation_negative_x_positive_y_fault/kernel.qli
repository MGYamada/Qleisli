// Modified from https://github.com/PennyLaneAI/demos/blob/3a04df83a16af3a2f0fd9398c0b5cc2c060ebedd/demonstrations_v2/tutorial_qubit_rotation/demo.py
// Selected symbol: circuit(params)
use std::quantum::h;
use std::quantum::z;
use std::quantum::s;
use std::quantum::phase_eighth;

unitary fn rz(q: Q<Bit>) -> Q<Bit> { adjoint(phase_eighth, s(q)) }
unitary fn rx(q: Q<Bit>) -> Q<Bit> { h(rz(h(q))) }
pub unitary fn kernel(q: Q<Bit>) -> Q<Bit> {
    adjoint(rx, h(z(q)))
}
