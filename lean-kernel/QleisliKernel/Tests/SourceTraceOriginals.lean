  ("std::reflection","//! Phase-fixed reflections, implemented as ordinary checked source.\n//!\n//! Inputs may be entangled with external references; no product-state promise.\n//! Contract identifier: R002. Private classical helpers grant no evidence privilege.\nuse std::transform::hadamard2;\nuse std::gate::z;\n\n/// Return 0 exactly on (0,0), and 1 on every other pair of basis labels.\n/// Computing this predicate and applying Z to its auxiliary gives phase +1\n/// on 00 and -1 elsewhere: 2|00><00| - I, including its sign.\nclassical fn nonzero2((a, b): (Bit, Bit)) -> Bit { not (not a and not b) }\n\n/// Apply the phase-fixed reflection 2|s><s| - I, with |s> = (H tensor H)|00>.\n/// Consume and return the two data owners with no input-state promise.\n/// The protected computed scope checks zero return of its temporary auxiliary;\n/// the name of this routine and this documentation do not grant that evidence.\npub unitary fn reflect_uniform2(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {\n    let q = hadamard2(q);\n    let q = with_computed(q, nonzero2) { |ancilla| z(ancilla) };\n    hadamard2(q)\n}\n"),
  ("std::state","//! Explicit ordinary state preparation and observation-bearing replacement.\n//! These definitions receive the same source, effect and native checks as users.\n// Copyright 2026 Qleisli Project Contributors. SPDX-License-Identifier: Apache-2.0.\n\n/// Prepare exactly |0>, coefficient +1, in one fresh Bit owner.\n/// The Unit input has no physical wire; the result allocates one physical wire.\n/// Tensor identity on every retained reference; no separability promise is inferred.\npub isometry fn init0() -> Q<Bit> {\n    basis unit(()) as _ { 0 }\n}\n\n/// Erase the complete incoming Bit owner and return an independently prepared |0>.\n/// This is Observe even when the original input happened to be zero.\n/// Correlations with every retained reference follow discard then preparation.\npub observe fn reset(q: Q<Bit>) -> Q<Bit> {\n    discard(q);\n    init0()\n}\n"),
