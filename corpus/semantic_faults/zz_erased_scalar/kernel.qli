// Selected symbol(s): U_C(gamma), single-edge factor
// Fixed-scope adaptation; see README.md and corpus/POLICY.md.

use std::quantum::h;
use std::quantum::t;
use std::quantum::cnot;
use std::quantum::join;
use std::quantum::split;

basis fn one(a: Bit) -> Bit { 1 }
unitary fn scalar(q: Q<Bit>) -> Q<Bit> {
    with_computed(q, one) { |flag| t(t(t(t(t(t(t(flag))))))) }
}
pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    let (a, b) = split(q);
    let (a, b) = cnot(a, b);
    let b = repeat_static(2, t, b);
    let (a, b) = cnot(a, b);
    join(a, b)
}

// Deliberate semantic mutation: Erase the RZ scalar: every basis probability still agrees, but the full two-wire operator differs by exp(+i*pi/4).
