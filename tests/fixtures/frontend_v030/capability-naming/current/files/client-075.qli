use std::quantum::phase_eighth;
pub unitary fn scalar(q: Q<Unit>) -> Q<Unit> { phase_eighth(q) }
pub unitary fn apply[const U: Op<Unit>](q: Q<Unit>) -> Q<Unit> requires Applicable(U) { U(q) }
pub unitary fn inverse[const U: Op<Unit>](q: Q<Unit>) -> Q<Unit> requires Adjointable(U) { adjoint(U)(q) }
pub unitary fn eight[const U: Op<Unit>](q: Q<Unit>) -> Q<Unit> requires Applicable(U) { apply[power(U,8)](q) }
pub unitary fn controlled_once[const U: Op<Unit>](c: Q<Bit>,q: Q<Unit>) -> (Q<Bit>,Q<Unit>) requires Controllable(U) { controlled(U)(c,q) }
pub unitary fn controlled_four[const U: Op<Unit>](c: Q<Bit>,q: Q<Unit>) -> (Q<Bit>,Q<Unit>) requires Controllable(U) { controlled(power(U,4))(c,q) }
