import QleisliKernel.Qirf.SourceSequence
import QleisliKernel.SourceTypes.Lexer

/-! Bounded executable source/Raw interval checks; no arm or sector gate is
replaced. A deliberately wrong pure operator passes the structural component
below, exhibiting why its result alone cannot authorize qmatch execution.
No maximum-size case or new matrix is generated by these tests.
Copyright 2026 Qleisli Project Contributors. SPDX-License-Identifier: Apache-2.0 -/
namespace QleisliKernel.Tests.SourceSequence
open Semantics Semantics.Raw Qirf.SourceSequence

def selection := "qmatch(s,q){Tag::A=>keep,Tag::B=>keep}"
def text (effect : String := "unitary") :=
  "// λ qmatch comment is not a site\npub enum Tag{A,B} unitary fn keep(q:Q<Bit>)->Q<Bit>{q} pub " ++ effect ++
  " fn route(s:Q<Tag>,q:Q<Bit>,u:Q<Unit>)->(Q<Unit>,Q<Tag>,Q<Bit>){let(s,q)=" ++ selection ++
  ";let(s,q)=" ++ selection ++ ";(u,s,q)}"

def offsets (source : String) : List Nat :=
  SourceTypes.QuantumSequence.originalOffsets ((SourceTypes.lexLocated source).toOption.getD [])

def positions (source : String := text) : List Position :=
  [⟨(offsets source)[0]?.getD 0,0,2⟩,⟨(offsets source)[1]?.getD 0,2,2⟩]

def program : Observation.Program :=
  ⟨[⟨0,[0],1⟩,⟨1,[1],1⟩,⟨2,[],0⟩],[],
    [.pure (.join 0 1 3),.pure (.split 3 4 5 1),.pure (.join 4 5 6),.pure (.split 6 7 8 1)],
    [2,7,8],[],.unitary⟩

def contextChecks (body : Observation.Program := program) (ranges : List Position := positions)
    (source : String := text) (work : Nat := 10000000) : Bool :=
  match (SourceTypes.QuantumSequence.read #[("main",source)] "main" "route").run work with
  | (.error _,_) => false
  | (.ok original,left) => (Qirf.SourceSequence.check original [] body ranges).run left |>.1.isOk

def first : Nat := (offsets text)[0]?.getD 0
def second : Nat := (offsets text)[1]?.getD 0

def wrongOperator : Observation.Program :=
  {program with operations := [.pure (.gate .h 1 9),.pure (.join 0 9 3),.pure (.split 3 4 5 1),
    .pure (.join 4 5 6),.pure (.split 6 7 8 1)]}

def observingProgram : Observation.Program :=
  {program with
    operations := [.pure (.join 0 1 3),.pure (.split 3 4 5 1),.measure 5 0],
    outputs := [2,4],
    effect := .observe}

def zeroRole (index : Nat) : SourceOwners.Owner := ⟨index,[.unit]⟩
def zeroFrame : Frame := [(4,.owner (zeroRole 0) 0),(5,.owner (zeroRole 1) 0)]

def controls : List (String × Bool) := [
  ("both original sites bind literal intervals of the same whole root",contextChecks),
  ("second interval cannot reuse the first token generation",
    !contextChecks {program with operations := [.pure (.join 0 1 3),.pure (.split 3 4 5 1),
      .pure (.join 0 1 6),.pure (.split 6 7 8 1)]}),
  ("missing original occurrence refuses",!contextChecks program [⟨first,0,4⟩]),
  ("duplicated occurrence refuses",!contextChecks program [⟨first,0,2⟩,⟨first,2,2⟩]),
  ("reordered original occurrences refuse",!contextChecks program [⟨second,0,2⟩,⟨first,2,2⟩]),
  ("an offset inside the original token refuses",!contextChecks program [⟨first+1,0,2⟩,⟨second,2,2⟩]),
  ("overlapping intervals refuse",!contextChecks program [⟨first,0,2⟩,⟨second,1,3⟩]),
  ("uncovered prefix refuses",!contextChecks program [⟨first,1,1⟩,⟨second,2,2⟩]),
  ("uncovered suffix refuses",!contextChecks program [⟨first,0,2⟩,⟨second,2,1⟩]),
  ("uncovered middle operation refuses",!contextChecks program [⟨first,0,1⟩,⟨second,2,2⟩]),
  ("a valid extra target gate cannot hide outside the intervals",
    !contextChecks {program with operations := program.operations ++ [.pure (.gate .h 8 9)],outputs := [2,7,9]}),
  ("a boundary inside a joined owner refuses",
    !contextChecks program [⟨first,0,1⟩,⟨second,1,3⟩]),
  ("actual output order retains the zero-width source owner",
    !contextChecks {program with outputs := [7,2,8]}),
  ("missing zero-width output owner refuses",!contextChecks {program with outputs := [7,8]}),
  ("duplicate output token refuses",!contextChecks {program with outputs := [2,7,7]}),
  ("public Unitary cannot use an Observe root",!contextChecks {program with effect := .observe}),
  ("public Observe remains the outer effect",contextChecks {program with effect := .observe}
    (positions (text "observe")) (text "observe")),
  ("hidden observation is not a pure interval",
    !contextChecks observingProgram),
  ("zero-width roles are selected by identity rather than wire lists",
    tokensOf zeroFrame [zeroRole 1,zeroRole 0] == some [5,4]),
  ("duplicate source role has no unique Raw token",
    tokenOf [(4,.owner (zeroRole 0) 0),(5,.owner (zeroRole 0) 0)] (zeroRole 0) == none),
  ("an opaque pair is not silently split into a source owner",
    tokenOf [(4,.pair (.owner (zeroRole 0) 0) (.owner (zeroRole 1) 0) 0)] (zeroRole 0) == none),
  ("no work budget refuses",!contextChecks program positions text 0),
  ("owner-valid wrong operator still requires the separate exact sector gate",
    contextChecks wrongOperator [⟨first,0,3⟩,⟨second,3,2⟩])]

example : controls.length = 23 := by decide +kernel
#guard controls.all (·.2)

end QleisliKernel.Tests.SourceSequence
