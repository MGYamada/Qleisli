-//! Shared runtime pattern-binding rules; no value here is acceptance evidence.
+//! Shared source pattern-name and runtime binding rules; no acceptance evidence.
 //!
 //! The borrowed view temporarily bridges the existing sized projection. It
 //! neither creates a second pattern tree nor changes lexical binder identities.
@@ -8,6 +8,38 @@ use super::types::Type;
 use std::borrow::Cow;
 use std::collections::BTreeSet;
 
+/// Claim one unchanged spelling using the caller's existing key representation
+/// and duplicate-name scope. Error formatting is needed only for a repeat.
+pub(super) fn claim<K: Ord, E>(
+    names: &mut BTreeSet<K>,
+    key: K,
+    duplicate: impl FnOnce() -> E,
+) -> Result<(), E> {
+    if names.insert(key) {
+        Ok(())
+    } else {
+        Err(duplicate())
+    }
+}
+
+/// Visit one original parameter pattern iteratively in source order. The
+/// caller's set spans its existing parameter list; no type or value is made.
+pub(super) fn claim_pattern_names<'a, E>(
+    pattern: &'a Pattern,
+    names: &mut BTreeSet<&'a String>,
+    mut duplicate: impl FnMut(&Ident) -> E,
+) -> Result<(), E> {
+    let mut pending = vec![pattern];
+    while let Some(pattern) = pending.pop() {
+        match &pattern.kind {
+            PatternKind::Name(name) => claim(names, &name.text, || duplicate(name))?,
+            PatternKind::Tuple(fields) => pending.extend(fields.iter().rev()),
+            PatternKind::Wildcard => {}
+        }
+    }
+    Ok(())
+}
+
 pub(super) enum Node<'a, P: PatternView> {
     Wildcard(Span),
     Name(&'a P::Name, Span),
