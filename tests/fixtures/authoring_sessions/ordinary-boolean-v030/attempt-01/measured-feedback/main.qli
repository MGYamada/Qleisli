use std::quantum::{init0,h,x};
use std::observe::measure_z;
pub observe fn f(a: Q<Bit>,b: Q<Bit>) -> (Bit,Q<Bit>) { let c = measure_z(a); let b = if c { x(b) } else { b }; (c,b) }
observe fn main() -> (Bit,Bit) { let (c,b) = f(h(init0()),init0()); (c,measure_z(b)) }
