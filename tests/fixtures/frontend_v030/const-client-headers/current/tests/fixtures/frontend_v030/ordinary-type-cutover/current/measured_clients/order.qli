use measurement::qpe;

/// Shared measured QPE; period candidates must still be validated classically.
pub observe fn order_readout[const n: Nat, const m: Nat, const U: Op<Bits<n>>](
    target: Q<Bits<n>>
) -> (Bits<m>, Q<Bits<n>>)
requires n >= 2, m >= 1, Controlled(U) {
    qpe[n,m,U](target)
}
