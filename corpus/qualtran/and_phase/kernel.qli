use std::quantum::z;
basis fn both((a, b): (Bit, Bit)) -> Bit { a and b }
pub unitary fn kernel(q: Q<(Bit, Bit)>) -> Q<(Bit, Bit)> {
    with_computed(q, both) { |flag| z(flag) }
}
