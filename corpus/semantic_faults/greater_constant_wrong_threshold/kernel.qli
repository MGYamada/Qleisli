// Selected symbol: GreaterThanConstant; bitsize=2, val=1
use std::quantum::cnot;
use std::quantum::split;
use std::quantum::join;

pub unitary fn kernel(q: Q<((Bit, Bit), Bit)>) -> Q<((Bit, Bit), Bit)> {
    let (ab, target) = split(q);
    let (a, b) = split(ab);
    let (a, target) = cnot(a, target);
    join(join(a, b), target)
}
