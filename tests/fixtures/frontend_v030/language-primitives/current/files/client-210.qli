// Separate legacy-spelling probe; original desired source is preserved.
use std::gate::z;
use std::state::init0;


unitary fn oracle(q: Q<Bit>) -> Q<Bit> { z(q) }
unitary fn amplify[const A: Basis, const k: Nat, const U: Op<A>](
    c: Q<Bit>, q: Q<A>
) -> (Q<Bit>, Q<A>)
requires Applicable(U), Adjointable(U), Controllable(U), k <= 2 {
    let (c,q) = controlled(power(U,k))(c,q);
    (c,adjoint(U)(q))
}
pub observe fn main() -> (Bit,Bit) {
    let (c,q) = amplify[type(Bit),1,oracle](h(init0()),h(init0()));
    (measure_z(c),measure_z(q))
}
